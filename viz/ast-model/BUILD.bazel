load("//tools/build_defs:kotlin.bzl", "kt_library", "kt_test")

kt_library(
    name = "ast-model",
    srcs = glob([
        "src/commonMain/kotlin/**/*.kt",
        "src/jvmMain/kotlin/**/*.kt",
    ]),
    visibility = ["//visibility:public"],
    deps = [
        "//parser/api",
        "//parser/core",
        "//parser/rewrite",
        "@maven//:org_apache_groovy_groovy",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_core_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
    ],
)

kt_test(
    name = "ast-model_test",
    srcs = glob([
        "src/commonTest/kotlin/**/*.kt",
        "src/jvmTest/kotlin/**/*.kt",
    ]),
    associates = [":ast-model"],
    test_packages = ["com.github.albertocavalcante.gvy"],
    deps = [
        "//parser/native",
        "@maven//:org_apache_groovy_groovy",
        "@maven//:org_assertj_assertj_core",
    ],
)
