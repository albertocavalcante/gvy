load("//tools/build_defs:kotlin.bzl", "kt_library", "kt_test")

# Compose Desktop application for AST visualization
# NOTE: Tagged manual - Compose Multiplatform has complex transitive dependencies
# that don't resolve well with Bazel's maven rules. Use Gradle for this module.
kt_library(
    name = "desktop",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    tags = ["manual"],
    visibility = ["//visibility:public"],
    deps = [
        "//parser/api",
        "//parser/core",
        "//parser/native",
        "//parser/rewrite",
        "//viz/ast-model",
        "@maven//:io_github_oshai_kotlin_logging_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
        "@maven//:ch_qos_logback_logback_classic",
    ],
)

kt_test(
    name = "desktop_test",
    srcs = glob(
        ["src/test/kotlin/**/*.kt"],
        allow_empty = True,
    ),
    associates = [":desktop"],
    tags = ["manual"],
    test_packages = ["com.github.albertocavalcante.gvy.viz.desktop"],
    deps = [],
)
