# shellcheck shell=bash
# .envrc
# Load SDKMAN environment if available
# Locate SDKMAN (Default or Homebrew)
if [[ -z "${SDKMAN_DIR:-}" ]]; then
    if [[ -d "${HOME}/.sdkman" ]]; then
        SDKMAN_DIR="${HOME}/.sdkman"
    elif command -v brew >/dev/null && [[ -d "$(brew --prefix sdkman-cli 2>/dev/null || true)/libexec" ]]; then
        SDKMAN_DIR="$(brew --prefix sdkman-cli)/libexec"
    fi
fi

# Load SDKMAN environment if available
if [[ -s ".sdkmanrc" ]] && [[ -n "${SDKMAN_DIR:-}" ]]; then
    JAVA_VERSION=$(grep "^java=" .sdkmanrc | cut -d= -f2 || true)
    if [[ -n "${JAVA_VERSION}" ]]; then
        candidate_home="${SDKMAN_DIR}/candidates/java/${JAVA_VERSION}"
        if [[ -d "${candidate_home}" ]]; then
            export JAVA_HOME="${candidate_home}"
            # Use direnv's PATH_add helper
            PATH_add "${JAVA_HOME}/bin"
            gvy_java_activated=1
            echo "☕️ Activated SDKMAN Java ${JAVA_VERSION} from ${candidate_home}"
        else
            # Reported below only if no Homebrew fallback is found either.
            gvy_sdkman_missing="Java ${JAVA_VERSION} not found at ${candidate_home}"
        fi
    fi
fi

# Without SDKMAN, fall back to Homebrew's JDK for the default test runtime (.java-version).
# Homebrew JDKs are keg-only: /usr/libexec/java_home does not list them, so macOS reports
# "Unable to locate a Java Runtime" even when one is installed. Gradle provisions the JDK 21
# compilation toolchain itself. An existing JAVA_HOME is respected.
if [[ -z "${gvy_java_activated:-}" ]] && [[ -z "${JAVA_HOME:-}" ]] && command -v brew >/dev/null; then
    java_major=$(head -n 1 .java-version 2>/dev/null || true)
    # Tolerate CRLF, surrounding whitespace and full versions such as 17.0.2.
    java_major=${java_major//[[:space:]]/}
    java_major=${java_major%%.*}
    java_major=${java_major:-17}
    brew_jdk_prefix=$(brew --prefix "openjdk@${java_major}" 2>/dev/null || true)
    if [[ -n "${brew_jdk_prefix}" ]]; then
        # macOS kegs nest a .jdk bundle; Linux kegs use libexec directly.
        for candidate_home in "${brew_jdk_prefix}/libexec/openjdk.jdk/Contents/Home" "${brew_jdk_prefix}/libexec"; do
            if [[ -x "${candidate_home}/bin/java" ]]; then
                export JAVA_HOME="${candidate_home}"
                PATH_add "${JAVA_HOME}/bin"
                echo "☕️ Activated Homebrew Java ${java_major} from ${candidate_home}"
                break
            fi
        done
    fi
fi
if [[ -n "${gvy_sdkman_missing:-}" ]] && [[ -z "${JAVA_HOME:-}" ]]; then
    echo "⚠️ ${gvy_sdkman_missing}. Please run './tools/macos/setup.sh' or install Homebrew openjdk@17."
fi

# Local High-Performance Gradle Override
# Overrides repo-level safe defaults (4GB/G1GC) with machine-specific power settings (8GB/ZGC)
# Previously: export ORG_GRADLE_PROJECT_org_gradle_jvmargs="-Xms2g -Xmx8g -XX:+UseZGC -XX:+ZGenerational -XX:MaxMetaspaceSize=1g -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8"
# echo "🐘 Gradle optimized for Local Dev (8GB Heap + ZGC)"

# Temporary adjustment for Mac Mini with less resources
export ORG_GRADLE_PROJECT_org_gradle_jvmargs="-Xms1g -Xmx3g -XX:+UseZGC -XX:+ZGenerational -XX:MaxMetaspaceSize=512m -XX:+HeapDumpOnOutOfMemoryError -Dfile.encoding=UTF-8"
echo "🐘 Gradle optimized for Local Dev (3GB Heap + ZGC - Mac Mini Temp)"

# Add agent scripts to PATH
PATH_add ".agent/scripts"
echo "🤖 Agent scripts added to PATH (invoke 'pr' command)"
