  "limits": [
    "Product source/patch/projection records are DATA only; no overlay will be applied",
    "Only mocked controls, read-only syntax/format checks and registered-own-Node Linux cases are authorized by this workflow",
    "No Java/Gradle/Mesh/queue/gvy fixture/CC/normal-hook/product-commit claim",
    "Available driver output and case summaries are retained. Legacy workers retain helper streams above4096 bytes as length/hash instead of full raw bytes; the guard decodes worker streams as UTF-8. No full failed-leaf raw-byte custody is claimed."
  ],
  "evidenceDebt": {
    "issue": "https://github.com/albertocavalcante/gvy/issues/1876",
    "owner": "Root8733 / canonical owned-command and affected caller owners",
    "impact": "Large failed helper-output cases cannot be reconstructed from summaries; worker-stream UTF-8 decoding is not byte-preserving",
    "reason": "Restricted bootstrap reuses the reviewed six-file harness with SPDX prefixes only; its serialization limits are retained and disclosed",
    "nextAction": "Before stronger maintained-caller/full-original evidence claims, persist bounded helper and worker raw bytes independently from original tuple/cleanup status and add failed-large-output and persistence-fault controls",
    "acceptance": "Source-bound failed large/binary-output controls retain exact original stdout/stderr bytes, byte counts and hashes plus original status/signal/cleanup and zero-remaining proof; independent final-source and runtime evidence review"
  },
  "evidenceScope": "Current-byte helper behavior assertions plus available driver/case summaries; not complete leaf raw-byte custody"
}
