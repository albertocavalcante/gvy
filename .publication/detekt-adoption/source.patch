+  if (reader) writeFileSync(join(root, 'tools/ci/read-evidence.mjs'), `
+    import { readFileSync } from 'node:fs';
+    export const readEvidenceBytes = path => readFileSync(path);
+    export const readEvidenceText = path => readFileSync(path, 'utf8');
+  `);
+  writeFileSync(join(root, 'tools/ci/run-gradle.mjs'), `
+    import { createHash, randomUUID } from 'node:crypto';
+    import { appendFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+    import { dirname, join, relative } from 'node:path';
+    const mode = ${JSON.stringify(mode)};
+    const value = flag => process.argv[process.argv.lastIndexOf(flag) + 1];
+    const control = JSON.parse(readFileSync(join(dirname(value('--init-script')), 'control.json'), 'utf8'));
+    const before = readFileSync(control.fixture, 'utf8');
+    const format = text => text.replaceAll('(1,2)', '(1, 2)').replaceAll('(1 , 2)', '(1, 2)')
+      .replaceAll('/* item */ ,', '/* item */,').replace('1 // first\\n        , 2,', '1, // first\\n        2,');
+    const formatted = mode === 'no-detection' ? before : format(before);
+    const applying = control.taskPath.endsWith('Apply');
+    const failed = !applying && formatted !== before;
+    const exit = mode === 'setup-failure' ? 1 : Number(failed);
+    const producer = value('--producer');
+    appendFileSync('calls.jsonl', JSON.stringify({ command: process.argv.slice(2), task: control.taskPath, fixture: control.fixture, before }) + '\\n');
+    const hash = text => createHash('sha256').update(text).digest('hex');
+    const record = (path, text) => ({ path, bytes: Buffer.byteLength(text), sha256: hash(text) });
+    const model = {
+      schemaVersion: 1,
+      sourceTask: { path: control.sourceTaskPath, className: 'com.diffplug.gradle.spotless.SpotlessTaskImpl_Decorated',
+        inputs: [record(control.fixture, before)] },
+      actionTask: { path: control.taskPath, className: 'com.diffplug.gradle.spotless.Spotless' + (applying ? 'Apply' : 'Check') + '_Decorated' },
+      cleanFiles: formatted === before ? [] : [record(relative(join(process.cwd(), 'tools/lint/analysis-health'), control.fixture).replaceAll('\\\\', '/'), formatted)],
+    };
+    if (mode === 'wrong-target') model.sourceTask.inputs.push(record('/other/File.kt', 'unrelated'));
+    if (mode === 'changed-input') model.sourceTask.inputs[0].sha256 = 'e'.repeat(64);
+    if (mode === 'wrong-clean-output' && model.cleanFiles.length) model.cleanFiles[0].sha256 = 'e'.repeat(64);
+    if (mode !== 'missing-model') writeFileSync(control.observation, JSON.stringify(model));
