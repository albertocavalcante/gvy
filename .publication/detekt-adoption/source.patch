+    }
+    writeFileSync(join(root, 'git'), `#!${process.execPath}
+if (process.argv[2] === 'rev-parse') console.log('a'.repeat(40));
+else if (process.argv[2] === 'status') console.log('');
+else process.exitCode = 1;
+`, { mode: 0o755 });
+    writeFileSync(join(root, 'gradlew'), `#!${process.execPath}
+import { appendFileSync } from 'node:fs';
+appendFileSync('gradle-argv.jsonl', JSON.stringify(process.argv.slice(2)) + '\\n');
+console.log('BUILD SUCCESSFUL in 1s');
+`, { mode: 0o755 });
+  }
+  return { root, module, cli, report: join(root, 'report'), cleanup };
