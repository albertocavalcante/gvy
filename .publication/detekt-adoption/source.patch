+for (const signal of ['SIGINT', 'SIGTERM']) test(`queued ${signal} during the final Detekt receipt write retains original runs and fails cancellation`, t => {
+  if (process.platform === 'win32') return t.skip('POSIX self-signal delivery required');
+  const fixture = healthyCli(t);
+  const receipt = join(fixture.report, 'analysis-health.json');
+  const proofPath = join(fixture.directory, 'queued-proof.json');
+  const driver = join(fixture.directory, 'queued-driver.mjs');
+  writeFileSync(driver, `
+import fs from 'node:fs'; import { syncBuiltinESMExports } from 'node:module'; import { setImmediate as turn } from 'node:timers/promises';
+const original = fs.writeFileSync; let sent = false, delivered = 0, handlersAtWrite = 0;
+const sentinel = () => { delivered++; }; process.on(${JSON.stringify(signal)}, sentinel);
+fs.writeFileSync = (path, bytes, ...rest) => {
+  const result = original(path, bytes, ...rest);
+  if (path === ${JSON.stringify(receipt)} && !sent) {
+    const model = JSON.parse(bytes); if (model.complete === true && model.ok === true) {
+      sent = true; handlersAtWrite = process.listenerCount(${JSON.stringify(signal)}); process.kill(process.pid, ${JSON.stringify(signal)});
+    }
+  } return result;
+}; syncBuiltinESMExports();
+process.argv = [process.execPath, ${JSON.stringify(fixture.cli)}, '--report-root', ${JSON.stringify(fixture.report)}];
+await import(${JSON.stringify(pathToFileURL(fixture.cli).href)});
+const until = performance.now() + 1000; while (!delivered && performance.now() < until) await turn();
+const receipt = JSON.parse(fs.readFileSync(${JSON.stringify(receipt)}));
+original(${JSON.stringify(proofPath)}, JSON.stringify({ sent, delivered, handlersAtWrite, exitCode: process.exitCode ?? 0, receipt }));
+process.off(${JSON.stringify(signal)}, sentinel);
+`);
+  const result = spawnSync(process.execPath, ['--max-old-space-size=128', driver], { cwd: fixture.directory,
+    timeout: 10000, encoding: 'utf8', maxBuffer: 1024 * 1024 });
+  assert.ifError(result.error);
+  const proof = JSON.parse(readFileSync(proofPath));
+  t.diagnostic(JSON.stringify({ signal, sent: proof.sent, delivered: proof.delivered, handlersAtWrite: proof.handlersAtWrite,
+    exitCode: proof.exitCode, complete: proof.receipt.complete, ok: proof.receipt.ok, originalExits: proof.receipt.runs.map(run => run.originalCommandExitCode) }));
+  assert.equal(proof.sent, true); assert(proof.delivered >= 1); assert(proof.handlersAtWrite >= 2);
+  assert.equal(result.status, signal === 'SIGINT' ? 130 : 143, result.stderr);
+  assert.equal(proof.receipt.complete, false); assert.equal(proof.receipt.ok, false);
+  assert.deepEqual(proof.receipt.runs.map(run => run.originalCommandExitCode), [0, 1]);
+});
