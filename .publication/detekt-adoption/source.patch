+++ b/tools/ci/gradle-arguments.mjs
@@ -0,0 +1,30 @@
+// SPDX-FileCopyrightText: Alberto Cavalcante and the gvy contributors
+// SPDX-License-Identifier: Apache-2.0
+
+// Gradle 9.8 built-in value options. Task-specific options remain untouched after --.
+const valueOptions = new Set([
+  '--console', '--console-unicode', '--warning-mode', '--gradle-user-home', '-g', '--include-build',
+  '--init-script', '-I', '--project-cache-dir', '--project-dir', '-p', '--project-prop', '-P',
+  '--system-prop', '-D', '--max-workers', '--priority', '--exclude-task', '-x',
+  '--dependency-verification', '-F', '--update-locks', '--write-verification-metadata', '-M',
+  '--configuration-cache-problems', '--develocity-plugin-version', '--develocity-url',
+]);
+
+export function splitGradleArguments(args) {
+  const options = [];
+  let index = 0;
+  for (; index < args.length && args[index] !== '--'; index++) {
+    const argument = args[index];
+    const equals = argument.indexOf('=');
+    const name = equals < 0 ? argument : argument.slice(0, equals);
+    let value = equals < 0 ? undefined : argument.slice(equals + 1);
+    const tokens = [argument];
+    if (equals < 0 && valueOptions.has(name)) {
+      if (args[index + 1] === undefined || args[index + 1] === '--') throw new Error('Missing Gradle argument for ' + name);
+      value = args[++index];
+      tokens.push(value);
+    }
+    options.push({ name, value, args: tokens });
+  }
+  return { options, taskArguments: args.slice(index) };
+}
