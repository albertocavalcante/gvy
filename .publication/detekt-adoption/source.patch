diff --git a/tools/lint/README.md b/tools/lint/README.md
index e621b580b..61d6cb227 100644
--- a/tools/lint/README.md
+++ b/tools/lint/README.md
@@ -13,7 +13,37 @@ This directory contains shared lint configuration files.
   - `actionlint -color -config-file tools/lint/actionlint.yml`
 - ghalint:
   - `ghalint -c tools/lint/ghalint.yaml run`
-- detekt (via Gradle):
-  - `./gradlew detekt`
+- Kotlin quality checks (Spotless formatting and Detekt analysis):
+  - `./gradlew lint`
+  - `./gradlew lintFix` to apply formatting fixes and check typed analysis.
+- Detekt analysis alone:
+  - `./gradlew detektTyped` checks every JVM Kotlin compilation with its own analysis classpath.
+  - `./gradlew detekt` runs syntax-only analysis. Some rules require typed analysis.
+  - These commands omit Spotless's comma formatting check; use `lint` for the complete policy.
 - shellcheck:
   - `shellcheck --rcfile tools/lint/shellcheckrc path/to/script.sh`
+
+## Analyzer and formatter controls
+
+CI runs the lint tool tests with `node --test tools/lint/*.test.mjs`. To exercise the real Gradle producers locally:
+
+```bash
+node tools/lint/detekt-analysis-health.mjs --report-root build/analysis-health
+node tools/lint/kotlin-formatting-health.mjs --report-root build/formatting-health
+```
+
+The analysis control requires a clean typed run and an exact deliberately unsafe finding. The formatting control checks
+clean input, rejection, correction, rechecking, and idempotence. Each retains the original Gradle exit and evidence;
+expected negative runs succeed only when the intended finding or formatting rejection is proved. Append
+`-- GRADLE_ARGS...` to pass toolchain or resource options. Ordinary Gradle lint also checks that Spotless covers every
+Detekt Kotlin source while excluding generated build output.
+
+The controls always rerun analysis without parallel execution; formatter controls also disable the build and
+configuration caches. The capture wrapper owns plain console output and all-warning diagnostics. Forwarded options
+cannot weaken those controls; invalid values for wrapper-owned options fail before Gradle starts.
+
+## Detekt path filters
+
+Use YAML lists for rule `includes` and `excludes`, with repository-relative globs such as `**/test/**`. Detekt 2 does
+not accept the scalar filter values supported by Detekt 1. A missing or null filter inherits the default; an empty list
+overrides it. The configured repository root supplies the filter base path.
diff --git a/tools/lint/analysis-health/build.gradle.kts b/tools/lint/analysis-health/build.gradle.kts
new file mode 100644
index 000000000..e84560acc
--- /dev/null
+++ b/tools/lint/analysis-health/build.gradle.kts
@@ -0,0 +1,232 @@
+// SPDX-FileCopyrightText: Alberto Cavalcante and the gvy contributors
+// SPDX-License-Identifier: Apache-2.0
+
+import dev.detekt.gradle.Detekt
+import dev.detekt.gradle.plugin.getSupportedKotlinVersion
+import groovy.json.JsonOutput
+import org.gradle.api.file.ConfigurableFileCollection
+import org.gradle.api.file.RegularFileProperty
+import org.gradle.api.provider.Property
+import org.gradle.api.tasks.Classpath
+import org.gradle.api.tasks.Input
+import org.gradle.api.tasks.InputFiles
+import org.gradle.api.tasks.Optional
+import org.gradle.api.tasks.OutputFile
+import org.gradle.api.tasks.TaskAction
+import java.io.File
+import java.io.IOException
+import java.io.OutputStream
+import java.security.DigestInputStream
+import java.security.MessageDigest
+import java.util.HexFormat
+
+plugins {
+    alias(libs.plugins.kotlin.jvm)
+}
+
+// These are real Kotlin compilations; the root applies/configures the actual Detekt plugin.
+sourceSets.create("violations")
+
+// Health controls must not configure unrelated lazy tasks while resolving typed ordering.
+if (providers.gradleProperty("detektHealth.invocationId").isPresent) {
+    tasks.register("detektHealthUnrelatedConfigurationSentinel") {
+        error("GVY_DETEKT_HEALTH_UNRELATED_TASK_CONFIGURED")
+    }
+}
+
+abstract class RecordDetektAnalysisHealth : DefaultTask() {
+    @get:Input
+    abstract val invocationId: Property<String>
+
+    @get:Input
+    abstract val consumerPath: Property<String>
+
+    @get:Input
+    abstract val consumerClass: Property<String>
+
+    @get:Input
+    abstract val toolVersion: Property<String>
+
+    @get:Input
+    abstract val basePath: Property<String>
+
+    @get:Input
+    abstract val jvmTarget: Property<String>
+
+    @get:Input
+    abstract val languageVersion: Property<String>
+
+    @get:Input
+    abstract val apiVersion: Property<String>
+
+    @get:Input
+    abstract val ignoreFailures: Property<Boolean>
+
+    @get:Input
+    abstract val failOnSeverity: Property<String>
+
+    @get:Input
+    abstract val buildUponDefaultConfig: Property<Boolean>
+
+    @get:Input
+    @get:Optional
+    abstract val baselinePath: Property<String>
+
+    @get:Input
+    abstract val reportPath: Property<String>
+
+    @get:InputFiles
+    abstract val sources: ConfigurableFileCollection
+
+    @get:InputFiles
+    abstract val configs: ConfigurableFileCollection
+
+    @get:Classpath
+    abstract val analysisClasspath: ConfigurableFileCollection
+
+    @get:Classpath
+    abstract val friends: ConfigurableFileCollection
+
+    @get:Classpath
+    abstract val tools: ConfigurableFileCollection
+
+    @get:Classpath
+    abstract val plugins: ConfigurableFileCollection
+
+    @get:OutputFile
+    abstract val observation: RegularFileProperty
+
+    @TaskAction
+    fun record() {
+        val model =
+            mapOf(
+                "schemaVersion" to 1,
+                "invocationId" to invocationId.get(),
+                "taskPath" to consumerPath.get(),
+                "taskClass" to consumerClass.get(),
+                "taskType" to Detekt::class.java.name,
+                "toolVersion" to toolVersion.get(),
+                "supportedKotlinVersion" to getSupportedKotlinVersion(),
+                "gradleJvm" to System.getProperty("java.runtime.version"),
+                "analysisMode" to if (analysisClasspath.isEmpty) "light" else "full",
+                "analysisClasspath" to analysisClasspath.files.map { it.canonicalPath }.sorted(),
+                "toolClasspath" to records(tools.files),
+                "pluginClasspath" to records(plugins.files),
+                "basePath" to basePath.get(),
+                "jvmTarget" to jvmTarget.get(),
+                "languageVersion" to languageVersion.get(),
+                "apiVersion" to apiVersion.get(),
+                "friendPaths" to friends.files.map { it.canonicalPath }.sorted(),
+                "ignoreFailures" to ignoreFailures.get(),
+                "failOnSeverity" to failOnSeverity.get(),
+                "buildUponDefaultConfig" to buildUponDefaultConfig.get(),
+                "baselineEnabled" to (baselinePath.orNull?.let { File(it).isFile } == true),
+                "sourceFiles" to records(sources.files),
+                "configFiles" to records(configs.files),
+                "report" to report(File(reportPath.get())),
+            )
+        val output = observation.get().asFile
+        output.parentFile.mkdirs()
+        output.writeText(JsonOutput.prettyPrint(JsonOutput.toJson(model)) + "\n")
+    }
+
+    companion object {
+        private const val REPORT_LIMIT_BYTES = 1024 * 1024
+        private const val REPORT_ERROR_LIMIT_CHARS = 512
+
+        private fun hash(bytes: ByteArray): String =
+            HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(bytes))
+
+        private fun hash(file: File): String {
+            val digest = MessageDigest.getInstance("SHA-256")
+            DigestInputStream(file.inputStream(), digest).use { input ->
+                input.transferTo(OutputStream.nullOutputStream())
+            }
+            return HexFormat.of().formatHex(digest.digest())
+        }
+
+        private fun records(files: Set<File>): List<Map<String, String>> =
+            files.sortedBy { it.canonicalPath }.map {
+                mapOf("path" to it.canonicalPath, "sha256" to hash(it))
+            }
+
+        private fun report(file: File): Map<String, Any?> {
+            val invalid = { message: String ->
+                mapOf(
+                    "path" to file.canonicalPath,
+                    "error" to message.take(REPORT_ERROR_LIMIT_CHARS),
+                    "sha256" to null,
+                    "bytes" to null,
+                )
+            }
+            if (!file.isFile) return invalid("Missing SARIF report")
+            return try {
+                val bytes = file.inputStream().use { it.readNBytes(REPORT_LIMIT_BYTES + 1) }
+                require(bytes.size <= REPORT_LIMIT_BYTES) { "SARIF report exceeds its byte limit" }
+                mapOf("path" to file.canonicalPath, "sha256" to hash(bytes), "bytes" to bytes.size, "error" to null)
+            } catch (error: IOException) {
+                invalid(error.message.orEmpty())
+            } catch (error: IllegalArgumentException) {
+                invalid(error.message.orEmpty())
+            }
+        }
+    }
+}
+
+for (taskName in listOf("detektMain", "detektViolations")) {
+    val consumer = tasks.named<Detekt>(taskName)
+    val output =
+        providers
+            .gradleProperty("detektHealth.outputRoot")
+            .map { File(it) }
+            .orElse(layout.buildDirectory.dir("reports/analysis-health/$taskName").map { it.asFile })
+    val reportFile = layout.file(output.map { it.resolve("report.sarif") })
+    val observationFile = layout.file(output.map { it.resolve("observation.json") })
+    val recorderName = "record${taskName.replaceFirstChar { it.uppercase() }}Health"
+    val record =
+        tasks.register<RecordDetektAnalysisHealth>(recorderName) {
+            val actual = consumer.get()
+            invocationId.set(providers.gradleProperty("detektHealth.invocationId").orElse("manual"))
+            consumerPath.set(actual.path)
+            consumerClass.set(actual.javaClass.name)
+            toolVersion.set(libs.versions.detekt.get())
+            basePath.set(File(actual.basePath.get()).canonicalPath)
+            jvmTarget.set(actual.jvmTarget.get())
+            languageVersion.set(actual.languageVersion.get())
+            apiVersion.set(actual.apiVersion.get())
+            ignoreFailures.set(actual.ignoreFailures.get())
+            failOnSeverity.set(actual.failOnSeverity.get().name)
+            buildUponDefaultConfig.set(actual.buildUponDefaultConfig.get())
+            actual.baseline.orNull
+                ?.asFile
+                ?.let { baselinePath.set(it.path) }
+            reportPath.set(
+                actual.reports.sarif.outputLocation
+                    .get()
+                    .asFile.canonicalPath,
+            )
+            sources.from(actual.source)
+            configs.from(actual.config)
+            analysisClasspath.from(actual.classpath)
+            friends.from(actual.friendPaths)
+            tools.from(actual.detektClasspath)
+            plugins.from(actual.pluginClasspath)
+            observation.set(observationFile)
+            // Always observe this invocation, including the intentionally failing analysis.
+            outputs.upToDateWhen { false }
+        }
+    consumer.configure {
+        debug.set(true)
+        reports.checkstyle.required.set(false)
+        reports.html.required.set(false)
+        reports.markdown.required.set(false)
+        reports.sarif.required.set(true)
+        reports.sarif.outputLocation.set(reportFile)
+        doFirst {
+            for (file in listOf(reportFile.get().asFile, observationFile.get().asFile)) {
+                check(!file.exists() || file.delete()) { "Cannot retire prior health evidence: $file" }
+            }
+        }
+        finalizedBy(record)
+    }
+}
