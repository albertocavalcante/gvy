+    if (mode === 'mutated-check' && !applying) writeFileSync(control.fixture, before + '// changed\\n');
+    if (mode === 'changed-policy') writeFileSync('build.gradle.kts', 'changed policy\\n');
+    if (mode === 'changed-control') writeFileSync(value('--init-script'), '// changed\\n');
+    const context = { schemaVersion: 1, headSha: 'a'.repeat(40), testedSha: 'b'.repeat(40),
+      runId: 'local-fixture', runAttempt: 1, invocationId: randomUUID(), command: 'gradle' };
+    if (mode === 'head-drift' && applying) context.testedSha = 'e'.repeat(40);
+    const output = join(value('--report-root'), producer + '-' + context.invocationId);
+    mkdirSync(output, { recursive: true });
+    let log = '> Task ' + control.sourceTaskPath + (mode === 'cached-task' ? ' FROM-CACHE' : '') + '\\n' +
+      '> Task ' + control.taskPath + (exit ? ' FAILED' : '') + '\\n';
+    if (exit) log += mode === 'setup-failure' ? 'Could not resolve formatter dependency\\n' :
+      "Execution failed for task '" + control.taskPath + "'.\\nThe following files had format violations:\\n" + control.fixture + '\\n';
+    log += 'BUILD ' + (exit ? 'FAILED' : 'SUCCESSFUL') + ' in 1s\\n';
+    if (mode === 'missing-format-rejection') log = log.replace('The following files had format violations:', 'Unexpected task failure:');
+    if (mode === 'extra-failed-task') log = '> Task :other FAILED\\n' + log;
+    const summary = { schemaVersion: 1, producer, context, complete: true, ok: exit === 0,
+      commandExitCode: exit, captureExitCode: 0, commandSignal: null, worktreeDirty: true, diagnostics: [], unexpected: [],
+      errors: exit ? ['Gradle command failed with exit 1'] : [], log: record('unused', log) };
