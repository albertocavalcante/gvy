+  test(`formatter rejects valued owned boolean ${argument} before a producer starts`, t => {
+    const fixture = run(t, 'healthy', true, ['--', argument]);
+    assert.equal(fixture.result.status, 1);
+    assert.match(fixture.result.stderr, /Gradle option takes no argument/);
+    assert.equal(existsSync(join(fixture.root, 'calls.jsonl')), false);
+    assertCleaned(fixture);
+  });
+}
+
+for (const args of [[], ['--report-root'], ['--report-root', ''], ['--report-root', '--offline'],
+  ['--report-root', 'report', '--offline'], ['--report-root', 'report', 'unexpected'], ['--report-root', 'report', '--']]) {
+  test(`rejects malformed formatter CLI arguments ${JSON.stringify(args)} before launching a producer`, t => {
+    const fixture = checkout(t);
+    const result = spawnSync(process.execPath, [fixture.cli, ...args], {
+      cwd: fixture.root, encoding: 'utf8', timeout: 10_000, maxBuffer: 1024 * 1024,
+    });
+    assert.ifError(result.error);
+    assert.equal(result.status, 1);
+    assert.match(result.stderr, /^Usage: kotlin-formatting-health\.mjs --report-root DIR \[-- GRADLE_ARGS\.\.\.\]\s*$/);
+    assert.equal(existsSync(join(fixture.root, 'calls.jsonl')), false);
+    assertCleaned(fixture);
+  });
+}
+
+for (const mode of ['no-detection', 'wrong-correction', 'mutated-check', 'wrong-target', 'missing-model',
+  'setup-failure', 'unexpected-diagnostic', 'changed-log', 'changed-context', 'wrong-producer', 'cached-task',
+  'changed-input', 'wrong-clean-output', 'missing-format-rejection', 'extra-failed-task', 'head-drift', 'changed-policy', 'changed-control']) {
+  test(`rejects ${mode} and cleans its owned fixture`, t => {
+    const fixture = run(t, mode);
+    assert.equal(fixture.result.status, 1, fixture.result.stderr);
+    assert.equal(fixture.receipt().ok, false);
+    assert.equal(fixture.receipt().complete, false);
+    assertCleaned(fixture);
+  });
+}
+
+test('an unavailable capture dependency retires an earlier successful receipt before creating a fixture', t => {
+  const fixture = checkout(t, 'healthy', false);
+  mkdirSync(fixture.report);
+  writeFileSync(join(fixture.report, 'formatting-health.json'), JSON.stringify({ complete: true, ok: true }));
+  const result = spawnSync(process.execPath, [fixture.cli, '--report-root', fixture.report], {
+    cwd: fixture.root, timeout: 10_000, maxBuffer: 1024 * 1024, encoding: 'utf8',
+  });
+  assert.ifError(result.error);
+  assert.equal(result.status, 1);
+  const receipt = JSON.parse(readFileSync(join(fixture.report, 'formatting-health.json'), 'utf8'));
+  assert.equal(receipt.ok, false);
+  assert.equal(receipt.complete, false);
+  assertCleaned(fixture);
+});
+
+for (const [signal, status] of [['SIGINT', 130], ['SIGTERM', 143]]) {
+  test(`${signal} waits for the active producer to close before fixture cleanup`, { timeout: 15_000 }, async t => {
+    const fixture = checkout(t, 'cancel');
+    const driverPath = join(fixture.root, 'driver.mjs');
+    writeFileSync(driverPath, `
+      import { realpathSync } from 'node:fs';
+      const disconnected = () => process.exit(1);
+      process.on('disconnect', disconnected);
+      process.on('message', signal => process.emit(signal));
+      process.argv = [process.execPath, realpathSync(${JSON.stringify(fixture.cli)}), '--report-root', ${JSON.stringify(fixture.report)}];
+      await import(${JSON.stringify(pathToFileURL(fixture.cli).href)});
+      process.off('disconnect', disconnected);
+      process.disconnect();
+    `);
+    const child = fork(driverPath, [], { cwd: fixture.root, stdio: ['pipe', 'pipe', 'pipe', 'ipc'] });
+    fixture.cleanup.push(() => {
+      child.stdin.destroy();
+      if (child.connected) child.disconnect();
+      if (child.exitCode === null && child.signalCode === null) child.kill('SIGKILL');
+    });
+    const cancel = new AbortController();
+    const timer = setTimeout(() => cancel.abort(new Error('Cancellation did not finish')), 10_000);
+    t.after(() => clearTimeout(timer));
+    let output = '';
+    let sent = false;
+    let bytes = 0;
+    child.stderr.on('data', chunk => {
+      bytes += chunk.length;
+      if (bytes > 64 * 1024) cancel.abort(new Error('Unexpected output volume'));
+    });
+    child.stdout.on('data', chunk => {
+      output += chunk.toString('utf8');
+      bytes += chunk.length;
+      if (bytes > 64 * 1024) cancel.abort(new Error('Unexpected output volume'));
+      if (!sent && output.includes('positive started\n')) {
+        sent = true;
+        child.send(signal, error => { if (error) cancel.abort(error); });
+      }
+    });
+    const [code, terminatedBy] = await once(child, 'exit', { signal: cancel.signal });
+    assert.equal(sent, true);
+    assert.equal(code, status);
+    assert.equal(terminatedBy, null);
+    assert.deepEqual(JSON.parse(readFileSync(join(fixture.root, 'fixture-at-child-close.json'), 'utf8')), { exists: true, signal });
+    assert.equal(readFileSync(join(fixture.root, 'calls.jsonl'), 'utf8').trim().split('\n').length, 1);
+    const receipt = JSON.parse(readFileSync(join(fixture.report, 'formatting-health.json'), 'utf8'));
+    assert.equal(receipt.complete, false);
+    assert.equal(receipt.ok, false);
+    assertCleaned(fixture);
+  });
+}
