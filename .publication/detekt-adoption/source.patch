+    if (mode === 'wrong-producer') summary.producer = 'other-producer';
+    writeFileSync(join(output, 'summary.json'), JSON.stringify(summary));
+    writeFileSync(join(output, 'context.json'), JSON.stringify(mode === 'changed-context' ? { ...context, headSha: 'd'.repeat(40) } : context));
+    writeFileSync(join(output, 'raw.log'), log);
+    if (mode === 'cancel') {
+      const stop = signal => {
+        writeFileSync('fixture-at-child-close.json', JSON.stringify({ exists: existsSync(control.fixture), signal }));
+        process.exit(signal === 'SIGINT' ? 130 : 143);
