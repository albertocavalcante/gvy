diff --git a/tools/lint/kotlin-formatting-health.mjs b/tools/lint/kotlin-formatting-health.mjs
new file mode 100644
index 000000000..67cf5593b
--- /dev/null
+++ b/tools/lint/kotlin-formatting-health.mjs
@@ -0,0 +1,305 @@
+// SPDX-FileCopyrightText: Alberto Cavalcante and the gvy contributors
+// SPDX-License-Identifier: Apache-2.0
+
+import { spawn } from 'node:child_process';
+import { createHash, randomUUID } from 'node:crypto';
+import { mkdirSync, mkdtempSync, readdirSync, realpathSync, rmSync, writeFileSync } from 'node:fs';
+import { basename, join, relative, resolve } from 'node:path';
+import { setImmediate as yieldEvents } from 'node:timers/promises';
+import { fileURLToPath } from 'node:url';
+import { isDeepStrictEqual } from 'node:util';
+
+const project = ':tools:lint:analysis-health';
+const sourceTask = `${project}:spotlessKotlin`;
+const hash = bytes => createHash('sha256').update(bytes).digest('hex');
+const canonical = [
+  'package formattinghealth', '',
+  '/** A separator token is `,`. */',
+  'fun commaText(): String = "1,2"', '',
+  '/**',
+  " * Like [removeCommentsAndStrings], but keeps the code's shape: every character of a comment or string literal",
+  ' * becomes a space and every newline is kept, so the result has the same length and the same lines as [code].',
+  ' * Line-based scanners can then clean a whole prefix once and still read it line by line, with strings and',
+  ' * comments that span lines handled (#1281).',
+  ' *',
+  ' * Also blanks dollar-slashy strings (`$/ ... /$`) and slashy strings (`/ ... /`). A `/` opens a slashy',
+  ' * string only where an expression starts (at the start of the code, after `(`, `[`, `{`, `,`, `=`, `:`,',
+  " * `;`, `!`, `&`, `|`, `?`, `~`, `>` (a closure's `->`) or a newline, or after `return`, `case`, `in` or",
+  ' * `assert`), so division stays code. `\'...\'` and `"..."` end at the end of their line even when',
+  ' * unterminated, as Groovy does not let them span lines, except inside a `"${...}"` interpolation; triple-quoted,',
+  ' * slashy and dollar-slashy strings may span lines.',
+  ' */',
+  'fun originalDocumentation(value: String): String = value', '',
+  'fun missingAfter(): List<Int> = listOf(1, 2)', '',
+  'fun unexpectedBefore(): List<Int> = listOf(1, 2)', '',
+  'fun adjacentComment(): List<Int> = listOf(1 /* item */, 2)', '',
+  'fun newlineComment(): List<Int> =',
+  '    listOf(',
+  '        1, // first',
+  '        2,',
+  '    )', '',
+].join('\n');
+const violations = canonical
+  .replace('missingAfter(): List<Int> = listOf(1, 2)', 'missingAfter(): List<Int> = listOf(1,2)')
+  .replace('unexpectedBefore(): List<Int> = listOf(1, 2)', 'unexpectedBefore(): List<Int> = listOf(1 , 2)')
+  .replace('/* item */,', '/* item */ ,')
+  .replace('1, // first\n        2,', '1 // first\n        , 2,');
+const stages = [
+  { name: 'positive', action: 'Check', exit: 0, before: canonical, after: canonical },
+  { name: 'negative', action: 'Check', exit: 1, before: violations, after: violations },
+  { name: 'apply', action: 'Apply', exit: 0, before: violations, after: canonical },
+  { name: 'recheck', action: 'Check', exit: 0, before: canonical, after: canonical },
+  { name: 'idempotent', action: 'Apply', exit: 0, before: canonical, after: canonical },
+];
+
+function requireEvidence(condition, message) {
+  if (!condition) throw new Error(message);
+}
+
+class Interrupted extends Error {
+  constructor(signal) {
+    super(`Kotlin formatting health interrupted by ${signal}`);
+    this.signal = signal;
+    this.exitCode = signal === 'SIGINT' ? 130 : 143;
+  }
+}
+
+function withControlArguments(args, controls, splitGradleArguments) {
+  const owned = new Set(['--rerun-tasks', '--parallel', '--no-parallel', '--build-cache', '--no-build-cache',
+    '--configuration-cache', '--no-configuration-cache']);
+  const { options, taskArguments } = splitGradleArguments(args);
+  for (const option of options) {
+    if (owned.has(option.name) && option.value !== undefined) throw new Error('Gradle option takes no argument: ' + option.name);
+  }
+  return [...options.filter(option => !owned.has(option.name)).flatMap(option => option.args), ...controls, ...taskArguments];
+}
+
+function runProducer(args, signal) {
+  signal.throwIfAborted();
+  return new Promise((accept, reject) => {
+    const child = spawn(process.execPath, ['tools/ci/run-gradle.mjs', ...args], { stdio: 'inherit' });
+    let failure;
+    const cancel = () => child.kill(signal.reason.signal);
+    signal.addEventListener('abort', cancel, { once: true });
+    child.once('error', error => { failure = error; });
+    child.once('close', (code, terminatedBy) => {
+      signal.removeEventListener('abort', cancel);
+      if (signal.aborted) reject(signal.reason);
+      else if (failure) reject(failure);
+      else accept({ code, signal: terminatedBy });
+    });
+  });
+}
+
+// The override controls only the fixture target. Normal steps/configuration remain inherited.
+function initScript(controlPath) {
+  const quoted = controlPath.replaceAll('\\', '\\\\').replaceAll("'", "\\'");
+  return `
+import groovy.json.JsonOutput
+import groovy.json.JsonSlurper
+import java.security.MessageDigest
+def control = new JsonSlurper().parse(new File('${quoted}'))
+gradle.projectsEvaluated {
+    def owner = gradle.rootProject.project('${project}')
+    def fixture = new File(control.fixture).canonicalFile
+    def record = { File file, String path ->
+        assert file.isFile() && file.length() <= 65536 : 'Invalid formatter evidence file'
+        [path: path, bytes: file.length(), sha256: MessageDigest.getInstance('SHA-256').digest(file.bytes).encodeHex().toString()]
+    }
+    def source = owner.tasks.named('spotlessKotlin')
+    def assertTarget = { task ->
+        assert task.target.files.collect { it.canonicalFile }.toSet() == ([fixture] as Set) : 'Formatter target escaped its owned fixture'
+    }
+    source.configure { task ->
+        task.setTarget(owner.files(fixture))
+        task.doFirst {
+            assertTarget(task)
+            new File(control.observation).text = JsonOutput.toJson([
+                schemaVersion: 1,
+                sourceTask: [path: task.path, className: task.class.name, inputs: [record(fixture, fixture.path)]]
+            ]) + '\\n'
+        }
+    }
+    owner.tasks.named(control.taskPath.tokenize(':').last()).configure { task ->
+        task.doFirst {
+            assertTarget(source.get())
+            def output = new File(control.observation)
+            def model = new JsonSlurper().parse(output)
+            model.actionTask = [path: task.path, className: task.class.name]
+            model.cleanFiles = owner.fileTree(source.get().cleanDirectory).files.collect { file ->
+                def path = source.get().cleanDirectory.toPath().relativize(file.toPath()).toString().replace('\\\\', '/')
+                assert path == owner.projectDir.toPath().relativize(fixture.toPath()).toString().replace('\\\\', '/') : 'Unrelated formatter output'
+                record(file, path)
+            }
+            output.text = JsonOutput.toJson(model) + '\\n'
+        }
+    }
+}
+`;
+}
+
+function verifyCapture({ summary, context, log, status, producer, taskPath, expectedExit, fixturePath }) {
+  requireEvidence(summary.schemaVersion === 1 && summary.complete === true && summary.captureExitCode === 0 &&
+    typeof summary.worktreeDirty === 'boolean' &&
+    summary.commandSignal === null && status.signal === null && status.code === expectedExit &&
+    summary.commandExitCode === expectedExit && summary.ok === (expectedExit === 0), 'Unexpected original producer outcome');
+  requireEvidence(summary.producer === producer && isDeepStrictEqual(summary.context, context) &&
+    context.schemaVersion === 1 && context.command === 'gradle' &&
+    [context.headSha, context.testedSha].every(value => /^[a-f0-9]{40}$/.test(value ?? '')) &&
+    typeof context.runId === 'string' && context.runId.length > 0 && Number.isSafeInteger(context.runAttempt) && context.runAttempt > 0 &&
+    typeof context.invocationId === 'string' && context.invocationId.length > 0, 'Wrong producer/source provenance');
+  requireEvidence(Array.isArray(summary.unexpected) && summary.unexpected.length === 0 &&
+    isDeepStrictEqual(summary.errors, expectedExit ? ['Gradle command failed with exit 1'] : []), 'Unexpected Gradle diagnostics');
+  requireEvidence(log.endsWith('\n') && !log.includes('\0') && summary.log?.bytes === Buffer.byteLength(log) &&
+    summary.log.sha256 === hash(log), 'Changed or incomplete producer log');
+  const text = log.replace(/\x1b\[[0-9;]*m/g, '').replaceAll('\r\n', '\n');
+  const lines = text.split('\n');
+  requireEvidence(lines.includes(`> Task ${sourceTask}`) && lines.includes(`> Task ${taskPath}${expectedExit ? ' FAILED' : ''}`),
+    'The actual formatter tasks did not execute');
+  requireEvidence(isDeepStrictEqual([...text.matchAll(/^> Task (:\S+) FAILED$/gm)].map(match => match[1]), expectedExit ? [taskPath] : []) &&
+    [...text.matchAll(/^BUILD (SUCCESSFUL|FAILED) in .+$/gm)].length === 1 &&
+    lines.some(line => line.startsWith(`BUILD ${expectedExit ? 'FAILED' : 'SUCCESSFUL'} in `)), 'Wrong Gradle completion evidence');
+  if (expectedExit) requireEvidence(text.includes('The following files had format violations:') &&
+    text.includes(`Execution failed for task '${taskPath}'`) && text.replaceAll('\\', '/').includes(fixturePath),
+  'Expected formatting rejection was a setup failure');
+  requireEvidence(!/^(?:\s*e:|\s*error:)|Exception in thread|OutOfMemoryError|NoClassDefFoundError|LinkageError|incompatible version of Kotlin|requires type resolution|requires analysis API/im.test(text),
+    'Formatter emitted setup/compiler errors or skipped analysis');
+}
+
+async function main(args) {
+  requireEvidence(args[0] === '--report-root' && args[1] && !args[1].startsWith('-') &&
+    (args.length === 2 || (args[2] === '--' && args.length >= 4)),
+  'Usage: kotlin-formatting-health.mjs --report-root DIR [-- GRADLE_ARGS...]');
+  const gradleArgs = args.slice(3);
+  mkdirSync(resolve(args[1]), { recursive: true });
+  const reportRoot = realpathSync(args[1]);
+  const receipt = join(reportRoot, 'formatting-health.json');
+  const result = { schemaVersion: 1, complete: false, ok: false, fixtureCleanedUp: true, runs: [] };
+  const save = () => writeFileSync(receipt, JSON.stringify(result, null, 2) + '\n');
+  save();
+  const cancellation = new AbortController();
+  const interrupt = () => cancellation.abort(new Interrupted('SIGINT'));
+  const terminate = () => cancellation.abort(new Interrupted('SIGTERM'));
+  process.on('SIGINT', interrupt);
+  process.on('SIGTERM', terminate);
+  let owned;
+  try {
+    const { readEvidenceBytes, readEvidenceText } = await import('../ci/read-evidence.mjs');
+    const { splitGradleArguments } = await import('../ci/gradle-arguments.mjs');
+    const root = realpathSync(process.cwd());
+    const module = realpathSync(join(root, 'tools/lint/analysis-health'));
+    const record = path => {
+      const bytes = readEvidenceBytes(path, 64 * 1024);
+      return { path, bytes: bytes.length, sha256: hash(bytes) };
+    };
+    const policy = ['build.gradle.kts', '.editorconfig', 'gradle/libs.versions.toml', 'tools/lint/analysis-health/build.gradle.kts',
+      'tools/ci/run-gradle.mjs', 'tools/ci/gradle-arguments.mjs', 'tools/ci/read-evidence.mjs', 'tools/lint/kotlin-formatting-health.mjs']
+      .map(file => record(join(root, file)));
+    const verifyPolicy = () => requireEvidence(policy.every(file => isDeepStrictEqual(record(file.path), file)), 'Control source/configuration changed during controls');
+    result.policy = policy;
+    result.targetMode = 'controlled health-project SpotlessTask.setTarget; canonical target coverage is separate';
+    owned = mkdtempSync(join(module, 'formatting-health-'));
+    result.fixtureCleanedUp = false;
+    const fixture = join(owned, 'FormattingControl.kt');
+    result.fixture = fixture;
+    writeFileSync(fixture, canonical, { flag: 'wx' });
+    for (const stage of stages) {
+      cancellation.signal.throwIfAborted();
+      verifyPolicy();
+      if (stage.name === 'negative') writeFileSync(fixture, violations);
+      requireEvidence(readEvidenceText(fixture, 64 * 1024) === stage.before, 'Unexpected fixture before formatter');
+      const output = join(reportRoot, `${stage.name}-${randomUUID()}`);
+      mkdirSync(output);
+      const taskPath = `${sourceTask}${stage.action}`;
+      const producer = `kotlin-formatting-health-${stage.name}`;
+      const observation = join(output, 'inputs.json');
+      const control = join(output, 'control.json');
+      writeFileSync(control, JSON.stringify({ fixture, observation, taskPath, sourceTaskPath: sourceTask }) + '\n', { flag: 'wx' });
+      const init = join(output, 'control.gradle');
+      writeFileSync(init, initScript(control), { flag: 'wx' });
+      const captureRoot = join(output, 'gradle');
+      const command = ['--report-root', captureRoot, '--producer', producer, taskPath,
+        ...withControlArguments(gradleArgs, ['--init-script', init,
+          '--rerun-tasks', '--no-build-cache', '--no-configuration-cache', '--no-parallel'], splitGradleArguments)];
+      result.activeRun = { name: stage.name, command, control: record(control), init: record(init),
+        input: { text: stage.before, sha256: hash(stage.before) }, output };
+      save();
+      const status = await runProducer(command, cancellation.signal);
+      const directories = readdirSync(captureRoot, { withFileTypes: true });
+      requireEvidence(directories.length === 1 && directories[0].isDirectory(), 'Expected one fresh capture receipt');
+      const receiptRoot = join(captureRoot, directories[0].name);
+      const summary = JSON.parse(readEvidenceText(join(receiptRoot, 'summary.json'), 1024 * 1024));
+      const context = JSON.parse(readEvidenceText(join(receiptRoot, 'context.json'), 1024 * 1024));
+      const log = readEvidenceText(join(receiptRoot, 'raw.log'), 16 * 1024 * 1024);
+      const run = { ...result.activeRun, receiptRoot, originalCommandExitCode: summary.commandExitCode,
+        producerOk: summary.ok, worktreeDirty: summary.worktreeDirty, context, outcomeSatisfied: false };
+      result.runs.push(run);
+      delete result.activeRun;
+      verifyCapture({ summary, context, log, status, producer, taskPath, expectedExit: stage.exit,
+        fixturePath: relative(module, fixture).replaceAll('\\', '/') });
+      requireEvidence(basename(receiptRoot) === `${producer}-${context.invocationId}`, 'Mismatched capture invocation');
+      const model = JSON.parse(readEvidenceText(observation, 64 * 1024));
+      const input = { path: fixture, bytes: Buffer.byteLength(stage.before), sha256: hash(stage.before) };
+      const clean = stage.before === canonical ? [] : [{
+        path: relative(module, fixture).replaceAll('\\', '/'), bytes: Buffer.byteLength(canonical), sha256: hash(canonical),
+      }];
+      const taskClass = `com.diffplug.gradle.spotless.Spotless${stage.action}`;
+      requireEvidence(model.schemaVersion === 1 && model.sourceTask?.path === sourceTask &&
+        ['com.diffplug.gradle.spotless.SpotlessTaskImpl', 'com.diffplug.gradle.spotless.SpotlessTaskImpl_Decorated'].includes(model.sourceTask.className) &&
+        isDeepStrictEqual(model.sourceTask.inputs, [input]) && model.actionTask?.path === taskPath &&
+        [taskClass, `${taskClass}_Decorated`].includes(model.actionTask.className) && isDeepStrictEqual(model.cleanFiles, clean),
+      'Wrong actual formatter task/input/canonical-output evidence');
+      const after = readEvidenceText(fixture, 64 * 1024);
+      requireEvidence(after === stage.after, 'Formatter changed valid content or did not perform the exact correction');
+      requireEvidence(isDeepStrictEqual(record(control), run.control) && isDeepStrictEqual(record(init), run.init), 'Formatter control changed during execution');
+      verifyPolicy();
+      run.observation = observation;
+      run.outputSource = { text: after, sha256: hash(after) };
+      run.outcomeSatisfied = true;
+      save();
+    }
+    requireEvidence(result.runs.every(run => isDeepStrictEqual(run.context.headSha, result.runs[0].context.headSha) &&
+      isDeepStrictEqual(run.context.testedSha, result.runs[0].context.testedSha)), 'Controls used different tested sources');
+    result.complete = true;
+    result.ok = true;
+  } catch (error) {
+    result.complete = false;
+    result.ok = false;
+    result.error = error.message;
+    throw error;
+  } finally {
+    try {
+      if (owned) rmSync(owned, { recursive: true, force: true });
+      result.fixtureCleanedUp = true;
+    } catch (error) {
+      result.complete = false;
+      result.ok = false;
+      result.error = `Owned fixture cleanup failed: ${error.message}`;
+      throw error;
+    } finally {
+      try {
+        save();
+        // The first check phase can precede queued OS signal delivery; keep handlers for the next turn too.
+        await yieldEvents();
+        await yieldEvents();
+        if (cancellation.signal.aborted) {
+          result.complete = false;
+          result.ok = false;
+          result.interruptedSignal = cancellation.signal.reason.signal;
+          result.error ??= cancellation.signal.reason.message;
+          save();
+          cancellation.signal.throwIfAborted();
+        }
+      } finally {
+        process.off('SIGINT', interrupt);
+        process.off('SIGTERM', terminate);
+      }
+    }
+  }
+  console.log(`Kotlin formatting controls verified; original producer exits retained: ${reportRoot}`);
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  try { await main(process.argv.slice(2)); }
+  catch (error) { console.error(error.message); process.exitCode = error instanceof Interrupted ? error.exitCode : 1; }
+}
