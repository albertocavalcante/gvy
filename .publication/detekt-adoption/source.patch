index 000000000..a637a68c1
--- /dev/null
+++ b/tools/lint/detekt-analysis-health.mjs
@@ -0,0 +1,359 @@
+// SPDX-FileCopyrightText: Alberto Cavalcante and the gvy contributors
+// SPDX-License-Identifier: Apache-2.0
+
+import { createHash, randomUUID } from 'node:crypto';
+import { isUtf8 } from 'node:buffer';
+import { spawn } from 'node:child_process';
+import { mkdirSync, realpathSync, readdirSync, writeFileSync } from 'node:fs';
+import { basename, join, posix, relative, resolve } from 'node:path';
+import { setImmediate as yieldEvents } from 'node:timers/promises';
+import { fileURLToPath } from 'node:url';
+
+const digest = bytes => createHash('sha256').update(bytes).digest('hex');
+const plain = text => text.replace(/\x1b\[[0-9;]*m/g, '').replaceAll('\r\n', '\n');
+const pathKey = path => posix.normalize(path.replaceAll('\\', '/'));
+const regexLiteral = text => text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+const validHash = hash => typeof hash === 'string' && /^[a-f0-9]{64}$/.test(hash);
+const negativeRule = 'UnsafeCallOnNullableType';
+const qualifiedNegativeRule = 'detekt.potential-bugs.UnsafeCallOnNullableType';
+const reportLimit = 1024 * 1024;
+const sarifSchema = 'https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json';
+const negativeFinding = {
+  line: 6, column: 41, rule: negativeRule, severity: 'error',
+  message: 'Calling !! on a nullable type will throw a NullPointerException at runtime in case the value is null. It should be avoided.',
+};
+const taskType = 'dev.detekt.gradle.Detekt';
+
+function sameFiles(actual, expected) {
+  const entries = values => Array.isArray(values) && values.every(value =>
+    typeof value?.path === 'string' && validHash(value.sha256)) ?
+    values.map(value => `${pathKey(value.path)}\0${value.sha256}`).sort() : null;
+  const left = entries(actual);
+  const right = entries(expected);
+  return left !== null && right !== null && JSON.stringify(left) === JSON.stringify(right);
+}
+
+function findingAt(findings, file, line, column, rule) {
+  return findings.find(finding => pathKey(finding.file) === pathKey(file) &&
+    finding.line === Number(line) && finding.column === Number(column) && finding.rule === rule);
+}
+
+function sameFinding(actual, expected) {
+  return typeof actual?.file === 'string' && typeof expected?.file === 'string' &&
+    pathKey(actual.file) === pathKey(expected.file) &&
+    ['line', 'column', 'rule', 'severity', 'message'].every(key => actual[key] === expected[key]);
+}
+
+// Validate the native fixture subset, not arbitrary SARIF; JSON.parse retains standard duplicate-key semantics.
+function sarifFindings(bytes, expected) {
+  if (!Buffer.isBuffer(bytes) || bytes.length > reportLimit || !isUtf8(bytes)) {
+    throw new Error('Missing, oversized or non-UTF-8 report');
+  }
+  let document;
+  try { document = JSON.parse(bytes.toString('utf8')); }
+  catch { throw new Error('Malformed JSON'); }
+  if (document?.version !== '2.1.0' || document.$schema !== sarifSchema ||
+      Object.keys(document).some(key => !['$schema', 'version', 'runs'].includes(key)) ||
+      !Array.isArray(document.runs) || document.runs.length !== 1) throw new Error('Unexpected SARIF envelope');
+  const run = document.runs[0];
+  const driver = run?.tool?.driver;
+  if (driver?.name !== 'detekt' || !Array.isArray(driver.rules) || !Array.isArray(run.results) ||
+      run.originalUriBaseIds !== undefined) throw new Error('Unsupported Detekt run');
+  const rules = new Map();
+  for (const rule of driver.rules) {
+    if (typeof rule?.id !== 'string' || !rule.id.startsWith('detekt.') ||
+        typeof rule.name !== 'string' || !rule.name || rules.has(rule.id)) throw new Error('Invalid or duplicate rule descriptor');
+    rules.set(rule.id, rule);
+  }
+  const negative = expected.kind === 'negative';
+  if (run.results.length !== (negative ? 1 : 0)) throw new Error('Unexpected finding count');
+  if (!negative) return [];
+  const result = run.results[0];
+  const descriptor = rules.get(result?.ruleId);
+  if (result?.ruleId !== qualifiedNegativeRule || descriptor?.name !== negativeRule) {
+    throw new Error('Wrong qualified negative rule or descriptor');
+  }
+  const level = result.level === undefined ? descriptor.defaultConfiguration?.level : result.level;
+  if (level !== 'error') throw new Error('Missing or incorrect effective finding severity');
+  if (!Array.isArray(result.locations) || result.locations.length !== 1) throw new Error('Ambiguous finding location');
+  const location = result.locations[0]?.physicalLocation;
+  const artifact = location?.artifactLocation;
+  const region = location?.region;
+  const source = expected.sourceFiles?.[0]?.path;
+  // Detekt emits raw invariant paths. Bind the owned source without interpreting URI escapes or external base maps.
+  if (expected.sourceFiles?.length !== 1 || typeof source !== 'string' || typeof expected.basePath !== 'string' ||
+      artifact?.uriBaseId !== '%SRCROOT%' || artifact.uri !== relative(expected.basePath, source).replaceAll('\\', '/')) {
+    throw new Error('Unsupported source path or URI base');
+  }
+  if (!Number.isSafeInteger(region?.startLine) || region.startLine <= 0 ||
+      !Number.isSafeInteger(region?.startColumn) || region.startColumn <= 0 ||
+      typeof result.message?.text !== 'string' || !result.message.text) throw new Error('Invalid finding position or message');
+  return [{
+    file: source, line: region.startLine, column: region.startColumn,
+    rule: descriptor.name, severity: level, message: result.message.text,
+  }];
+}
+
+function lintDiagnostic(raw, findings) {
+  const line = raw.trim();
+  const full = line.match(/^e: (.+):(\d+):(\d+) (.+) \[([A-Za-z][A-Za-z0-9]*)\]$/);
+  if (full) {
+    const finding = findingAt(findings, full[1], full[2], full[3], full[5]);
+    return finding?.message === full[4];
+  }
+  // Detekt also emits indented, abbreviated console summaries of the same finding.
+  const brief = /^\s/.test(raw) && line.match(/^e: ([A-Za-z][A-Za-z0-9]*) - \[(.+)\] at (.+):(\d+):(\d+)$/);
+  if (!brief) return false;
+  const finding = findingAt(findings, brief[3], brief[4], brief[5], brief[1]);
+  const prefix = brief[2].replace(/\(\.\.\.\)$/, '');
+  return prefix.length > 0 && finding?.message.startsWith(prefix) === true;
+}
+
+/** Assess one actual Gradle Detekt consumer; an expected lint failure stays failed in its producer receipt. */
+export function assessDetektAnalysis({ expected, summary, observation, log, reportBytes } = {}) {
+  const errors = [];
+  const compilerErrors = [];
+  const metadataErrors = [];
+  const skippedTypedRules = [];
+  const fail = message => errors.push(message);
+  if (!expected || !['positive', 'negative'].includes(expected.kind)) {
+    return { ok: false, errors: ['Missing expected health-control identity'], compilerErrors, metadataErrors, skippedTypedRules };
+  }
+  if (!summary?.complete || summary.captureExitCode !== 0) fail('Incomplete Gradle capture');
+  if (!Array.isArray(summary?.unexpected) || summary.unexpected.length) fail('Unaccounted Gradle diagnostics');
+  if (!/^[a-f0-9]{40}$/.test(summary?.context?.headSha ?? '') ||
+      !/^[a-f0-9]{40}$/.test(summary?.context?.testedSha ?? '')) fail('Missing tested source identity');
+  const negative = expected.kind === 'negative';
+  const exit = negative ? 1 : 0;
+  if (summary?.commandExitCode !== exit || summary?.ok !== !negative) fail('Unexpected original command outcome');
+  const allowedErrors = negative ? ['Gradle command failed with exit 1'] : [];
+  if (JSON.stringify(summary?.errors) !== JSON.stringify(allowedErrors)) fail('Unexpected producer errors');
+  const rawLog = typeof log === 'string' ? log : '';
+  if (typeof log !== 'string' || !log.endsWith('\n') || log.includes('\0') ||
+      summary?.log?.bytes !== Buffer.byteLength(rawLog) || summary?.log?.sha256 !== digest(rawLog)) {
+    fail('Missing, changed or incomplete raw log');
+  }
+  const text = plain(rawLog);
+  const markers = [...text.matchAll(/^BUILD (SUCCESSFUL|FAILED) in .+$/gm)];
+  if (markers.length !== 1 || markers[0]?.[1] !== (negative ? 'FAILED' : 'SUCCESSFUL')) fail('Wrong Gradle completion evidence');
+  const failedTasks = [...text.matchAll(/^> Task (:\S+) FAILED$/gm)].map(match => match[1]);
+  if (JSON.stringify(failedTasks) !== JSON.stringify(negative ? [expected.taskPath] : [])) fail('Unexpected failed task');
+  if (!text.split('\n').includes(`> Task ${expected.taskPath}${negative ? ' FAILED' : ''}`)) {
+    fail('The actual typed consumer did not execute');
+  }
+  const cli = text.split('\n').filter(line => /^java -jar detekt-cli-\S+ /.test(line));
+  if (cli.length !== 1 || !/--analysis-mode full(?:\s|$)/.test(cli[0] ?? '') ||
+      /--analysis-mode light(?:\s|$)/.test(cli[0] ?? '') ||
+      !(cli[0] ?? '').includes(`--report sarif:${expected.reportPath}`)) fail('Missing actual full-analysis/report arguments');
+  if (!/^Phase ValidateClasspath took .+$/m.test(text)) fail('Missing classpath-validation phase');
+  const model = observation;
+  if (model?.schemaVersion !== 1 || model.invocationId !== expected.invocationId || model.taskPath !== expected.taskPath) {
+    fail('Missing or stale consumer observation');
+  }
+  if (model?.taskType !== taskType || !model?.taskClass?.startsWith(`${taskType}_`)) fail('Not the actual Detekt plugin task');
+  if (model?.toolVersion !== expected.toolVersion) fail('Wrong analyzer version');
+  if (model?.basePath !== expected.basePath) fail('Wrong source/report base path');
+  if (model?.analysisMode !== 'full' || !Array.isArray(model.analysisClasspath) || !model.analysisClasspath.length) {
+    fail('Consumer has no typed-analysis classpath');
+  }
+  for (const [field, flag] of [
+    ['jvmTarget', 'jvm-target'], ['languageVersion', 'language-version'], ['apiVersion', 'api-version'],
+  ]) {
+    const value = expected.compilerOptions?.[field];
+    if (typeof value !== 'string' || model?.[field] !== value ||
+        !new RegExp(`(?:^|\\s)--${flag} ${regexLiteral(value)}(?:\\s|$)`).test(cli[0] ?? '')) {
+      fail(`Missing or incorrect ${field} compiler option`);
+    }
+  }
+  if (!Array.isArray(model?.friendPaths) || !model.friendPaths.every(path => typeof path === 'string' && path.length > 0)) {
+    fail('Missing actual compilation friend-path evidence');
+  }
+  if (!Array.isArray(model?.toolClasspath) || !model.toolClasspath.some(file =>
+    typeof file?.path === 'string' && basename(file.path) === `detekt-cli-${expected.toolVersion}.jar` && validHash(file.sha256))) {
+    fail('Missing resolved analyzer identity');
+  }
+  if (!Array.isArray(model?.pluginClasspath) || !model.pluginClasspath.length ||
+      !model.pluginClasspath.every(file => typeof file?.path === 'string' && validHash(file.sha256))) fail('Missing rule-plugin identity');
+  if (model?.ignoreFailures !== false || model.failOnSeverity !== 'Info' || model.buildUponDefaultConfig !== true ||
+      model.baselineEnabled !== false) fail('Consumer weakens the expected lint policy');
+  if (!sameFiles(model?.sourceFiles, expected.sourceFiles)) fail('Wrong or changed source inputs');
+  if (!sameFiles(model?.configFiles, expected.configFiles)) fail('Wrong or changed root policy');
+  const report = model?.report;
+  const bounded = Buffer.isBuffer(reportBytes) && reportBytes.length <= reportLimit;
+  if (report?.error !== null || report?.path !== expected.reportPath || !bounded ||
+      report.bytes !== reportBytes.length || report.sha256 !== digest(reportBytes)) {
+    fail('Missing, invalid or stale structured report');
+  }
+  let findings = [];
+  try { findings = sarifFindings(reportBytes, expected); }
+  catch (error) { fail(`Native SARIF: ${error.message}`); }
+  const wellFormed = findings.every(finding => typeof finding?.file === 'string' &&
+    Number.isInteger(finding.line) && finding.line > 0 && Number.isInteger(finding.column) && finding.column > 0 &&
+    typeof finding.rule === 'string' && typeof finding.message === 'string');
+  if (!wellFormed) fail('Invalid structured finding');
+  if (!negative && findings.length !== 0) fail('Positive control reported lint findings');
+  if (negative && (findings.length !== 1 || findings[0]?.rule !== negativeRule ||
+      pathKey(findings[0]?.file ?? '') !== pathKey(expected.sourceFiles?.[0]?.path ?? '') ||
+      !sameFinding(findings[0], expected.finding))) fail('Wrong genuine-violation control');
+  const trustedFindings = wellFormed ? findings : [];
+  for (const line of text.split('\n')) {
+    if (/compiled with an incompatible version of Kotlin|binary version of its metadata|actual metadata version/i.test(line)) {
+      metadataErrors.push(line);
+    }
+    if (/requires type resolution but it was run without it|rules? .*requires analysis API/i.test(line)) skippedTypedRules.push(line);
+    if (/^\s*(?:e:|error:)|:\s+error:/i.test(line) && !lintDiagnostic(line, trustedFindings)) compilerErrors.push(line);
+    if (/Exception in thread|OutOfMemoryError|NoClassDefFoundError|LinkageError/.test(line)) compilerErrors.push(line);
+  }
+  if (metadataErrors.length) fail('Analyzer emitted incompatible Kotlin metadata errors');
+  if (compilerErrors.length) fail('Analyzer or compiler emitted errors outside its exact lint report');
+  if (skippedTypedRules.length) fail('Typed rules were skipped');
+  return { ok: errors.length === 0, errors, compilerErrors, metadataErrors, skippedTypedRules };
+}
+
+class Interrupted extends Error {
+  constructor(signal) {
+    super(`Detekt analysis health interrupted by ${signal}`);
+    this.signal = signal;
+    this.exitCode = signal === 'SIGINT' ? 130 : 143;
+  }
+}
+
+function withControlArguments(args, controls, splitGradleArguments) {
+  const owned = new Set(['--rerun-tasks', '--parallel', '--no-parallel']);
+  const { options, taskArguments } = splitGradleArguments(args);
+  for (const option of options) {
+    if (owned.has(option.name) && option.value !== undefined) throw new Error('Gradle option takes no argument: ' + option.name);
+  }
+  return [...options.filter(option => !owned.has(option.name)).flatMap(option => option.args), ...controls, ...taskArguments];
+}
+
+function runProducer(args, signal) {
+  signal.throwIfAborted();
+  return new Promise((accept, reject) => {
+    const child = spawn(process.execPath, ['tools/ci/run-gradle.mjs', ...args], { stdio: 'inherit' });
+    const cancel = () => child.kill(signal.reason.signal);
+    signal.addEventListener('abort', cancel, { once: true });
+    child.once('error', error => {
+      signal.removeEventListener('abort', cancel);
+      reject(signal.aborted ? signal.reason : error);
+    });
+    child.once('close', (code, terminatedBy) => {
+      signal.removeEventListener('abort', cancel);
+      accept({ code, signal: terminatedBy });
+    });
+  }).then(status => {
+    signal.throwIfAborted();
+    return status;
+  });
+}
+
+async function main(args) {
+  if (args[0] !== '--report-root' || !args[1] || args[1].startsWith('-') ||
+      (args.length !== 2 && (args[2] !== '--' || args.length < 4))) {
+    throw new Error('Usage: detekt-analysis-health.mjs --report-root DIR [-- GRADLE_ARGS...]');
+  }
+  const gradleArgs = args.slice(3);
+  mkdirSync(resolve(args[1]), { recursive: true });
+  const reportRoot = realpathSync(args[1]);
+  const receipt = join(reportRoot, 'analysis-health.json');
+  // Retire an earlier verdict before imports, input reads or producers can fail.
+  writeFileSync(receipt, JSON.stringify({ schemaVersion: 1, complete: false, ok: false, runs: [] }, null, 2) + '\n');
+  const cancellation = new AbortController();
+  const interrupt = () => cancellation.abort(new Interrupted('SIGINT'));
+  const terminate = () => cancellation.abort(new Interrupted('SIGTERM'));
+  process.on('SIGINT', interrupt);
+  process.on('SIGTERM', terminate);
+  try { await verifyControls(reportRoot, receipt, cancellation.signal, gradleArgs); }
+  finally {
+    process.off('SIGINT', interrupt);
+    process.off('SIGTERM', terminate);
+  }
+}
+
+async function verifyControls(reportRoot, receipt, signal, gradleArgs) {
+  // Reuse the established evidence reader and capture/provenance producer; ordinary Gradle lint does not invoke Node.
+  const { readEvidenceBytes, readEvidenceText } = await import('../ci/read-evidence.mjs');
+  const { splitGradleArguments } = await import('../ci/gradle-arguments.mjs');
+  signal.throwIfAborted();
+  const checkout = realpathSync(process.cwd());
+  const moduleRoot = join(checkout, 'tools/lint/analysis-health');
+  const config = join(checkout, 'tools/lint/detekt.yml');
+  const catalog = readEvidenceText(join(checkout, 'gradle/libs.versions.toml'), 1024 * 1024);
+  const version = [...catalog.matchAll(/^detekt\s*=\s*"([^"]+)"\s*$/gm)];
+  if (version.length !== 1) throw new Error('Cannot identify the catalog Detekt version');
+  const language = catalog.match(/^kotlin\s*=\s*"(\d+\.\d+)\.\d+[^"]*"\s*$/m)?.[1];
+  if (!language) throw new Error('Cannot identify the catalog Kotlin language/API version');
+  const record = path => ({ path: realpathSync(path), sha256: digest(readEvidenceBytes(path, 1024 * 1024)) });
+  const configFiles = [record(config)];
+  const runs = [];
+  for (const kind of ['positive', 'negative']) {
+    signal.throwIfAborted();
+    const invocationId = randomUUID();
+    const output = join(reportRoot, `${kind}-${invocationId}`);
+    mkdirSync(output);
+    const taskPath = `:tools:lint:analysis-health:${kind === 'positive' ? 'detektMain' : 'detektViolations'}`;
+    const sourceRoot = join(moduleRoot, kind === 'positive' ? 'src/main/kotlin/health' : 'src/violations/kotlin/health');
+    const sourceFiles = (kind === 'positive' ? ['Clean.kt', 'Regex.kt', 'CommaFormatting.kt'] : ['Unsafe.kt'])
+      .map(name => record(join(sourceRoot, name)));
+    const expected = {
+      kind, invocationId, taskPath, basePath: checkout,
+      toolVersion: version[0][1], reportPath: join(output, 'report.sarif'),
+      compilerOptions: { jvmTarget: '17', languageVersion: language, apiVersion: language },
+      sourceFiles, configFiles,
+      ...(kind === 'negative' ? { finding: { file: sourceFiles[0].path, ...negativeFinding } } : {}),
+    };
+    const captureRoot = join(output, 'gradle');
+    const command = [
+      '--report-root', captureRoot, '--producer', `detekt-health-${kind}`,
+      kind === 'positive' ? ':tools:lint:analysis-health:detektTyped' : taskPath,
+      ...withControlArguments(gradleArgs, ['--rerun-tasks', '--no-parallel',
+        `-PdetektHealth.outputRoot=${output}`, `-PdetektHealth.invocationId=${invocationId}`], splitGradleArguments),
+    ];
+    writeFileSync(receipt, JSON.stringify({ schemaVersion: 1, complete: false, ok: false, runs,
+      activeRun: { kind, command, expected } }, null, 2) + '\n');
+    const status = await runProducer(command, signal);
+    const directories = readdirSync(captureRoot, { withFileTypes: true }).filter(value => value.isDirectory());
+    if (directories.length !== 1) throw new Error('Expected one fresh Gradle invocation receipt');
+    const receiptRoot = join(captureRoot, directories[0].name);
+    const summary = JSON.parse(readEvidenceText(join(receiptRoot, 'summary.json'), 8 * 1024 * 1024));
+    const log = readEvidenceText(join(receiptRoot, 'raw.log'), 128 * 1024 * 1024);
+    let observation;
+    let reportBytes;
+    const evidenceErrors = [];
+    try { observation = JSON.parse(readEvidenceText(join(output, 'observation.json'), 8 * 1024 * 1024)); }
+    catch (error) { evidenceErrors.push(`Consumer observation: ${error.message}`); }
+    try { reportBytes = readEvidenceBytes(expected.reportPath, reportLimit); }
+    catch (error) { evidenceErrors.push(`SARIF report: ${error.message}`); }
+    const result = assessDetektAnalysis({ expected, summary, observation, log, reportBytes });
+    result.errors.push(...evidenceErrors);
+    if (status.signal || status.code !== (summary.commandExitCode === 0 && summary.ok ? 0 : 1)) {
+      result.errors.push('Capture wrapper exit contradicts its original-command receipt');
+    }
+    result.ok &&= result.errors.length === 0;
+    runs.push({ kind, command, expected, result, receiptRoot, originalCommandExitCode: summary.commandExitCode, context: summary.context });
+  }
+  const sameHead = runs.every(run => run.context?.headSha === runs[0].context?.headSha &&
+    run.context?.testedSha === runs[0].context?.testedSha);
+  const result = {
+    schemaVersion: 1, complete: true, ok: sameHead && runs.every(run => run.result.ok), sameTestedHead: sameHead, runs,
+  };
+  writeFileSync(receipt, JSON.stringify(result, null, 2) + '\n');
+  // The first check phase can precede queued OS signal delivery; keep handlers for the next turn too.
+  await yieldEvents();
+  await yieldEvents();
+  if (signal.aborted) {
+    result.complete = false;
+    result.ok = false;
+    result.interruptedSignal = signal.reason.signal;
+    result.error = signal.reason.message;
+    writeFileSync(receipt, JSON.stringify(result, null, 2) + '\n');
+    signal.throwIfAborted();
+  }
+  console.log(`Detekt typed-analysis controls ${result.ok ? 'verified' : 'failed'}; original producer exits retained: ${reportRoot}`);
+  process.exitCode = result.ok ? 0 : 1;
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  try { await main(process.argv.slice(2)); }
+  catch (error) { console.error(error.message); process.exitCode = error instanceof Interrupted ? error.exitCode : 1; }
+}
