+test('rejects malformed native JSON even if an old reconstructed envelope claims no findings', () => {
+  const input = withReportBytes(healthy(), Buffer.from('{"version":"2.1.0","runs":['));
+  input.observation.report.findings = [];
+  assert.equal(assessDetektAnalysis(input).ok, false);
+});
+
+test('rejects invalid UTF-8 rather than accepting replacement characters in report metadata', () => {
+  const document = sarif();
+  document.runs[0].tool.driver.informationUri = 'https://detekt.dev/ENCODING_MARKER';
+  const [before, after] = JSON.stringify(document).split('ENCODING_MARKER');
+  const input = withReportBytes(healthy(), Buffer.concat([Buffer.from(before), Buffer.from([0xff]), Buffer.from(after)]));
+  assert.equal(assessDetektAnalysis(input).ok, false);
+});
+
+test('rejects a deeply nested invalid report without rendering its untrusted object tree', () => {
+  const bytes = Buffer.from('{"version":"2.1.0","runs":' + '['.repeat(10_000) + '0' + ']'.repeat(10_000) + '}');
+  assert.equal(assessDetektAnalysis(withReportBytes(healthy(), bytes)).ok, false);
+});
+
+test('accepts a wide legitimate descriptor table within the report byte budget', () => {
+  const document = sarif();
+  document.runs[0].tool.driver.rules.push(...Array.from({ length: 4_000 }, (_unused, index) => ({
+    id: `detekt.probe.Rule${index}`, name: `Rule${index}`,
+    defaultConfiguration: { enabled: true, level: 'error' },
+    shortDescription: { text: 'A safe bounded descriptor description.' },
+  })));
+  const input = withSarif(healthy(), document);
+  assert.ok(input.reportBytes.length > reportLimit / 2);
+  assert.ok(input.reportBytes.length < reportLimit);
+  assert.equal(assessDetektAnalysis(input).ok, true);
+});
+
+test('accepts a valid report exactly at the byte limit', () => {
+  const input = healthy();
+  withReportBytes(input, Buffer.from(input.reportBytes.toString().padEnd(reportLimit, ' ')));
+  assert.equal(assessDetektAnalysis(input).ok, true);
+});
+
+test('rejects a valid JSON report exceeding the byte limit by one byte', () => {
+  const input = healthy();
+  withReportBytes(input, Buffer.from(input.reportBytes.toString().padEnd(reportLimit + 1, ' ')));
+  assert.equal(assessDetektAnalysis(input).ok, false);
+});
+
+for (const bytes of [undefined, 1]) {
+  test(`rejects report receipt byte count ${bytes} instead of accepting matching hashes alone`, () => {
+    const input = healthy();
+    input.observation.report.bytes = bytes;
+    assert.equal(assessDetektAnalysis(input).ok, false);
+  });
+}
+
+for (const [signal, exitCode] of [['SIGINT', 130], ['SIGTERM', 143]]) {
+  test(`${signal} during the positive CLI producer stops before the negative control and retains incomplete failed evidence`,
+    { timeout: 15_000 }, async t => {
+      const temporary = mkdtempSync(join(tmpdir(), 'gvy-analysis-health-cancel-'));
+      let driver;
+      t.after(() => {
+        driver?.stdin.destroy();
+        if (driver?.connected) driver.disconnect();
+        if (driver && driver.exitCode === null && driver.signalCode === null) driver.kill('SIGKILL');
+        rmSync(temporary, { recursive: true, force: true });
+      });
+      const output = join(temporary, 'report');
+      const guard = join(temporary, 'tools/lint/detekt-analysis-health.mjs');
+      mkdirSync(join(temporary, 'tools/lint/analysis-health/src/main/kotlin/health'), { recursive: true });
+      mkdirSync(join(temporary, 'tools/lint/analysis-health/src/violations/kotlin/health'), { recursive: true });
+      mkdirSync(join(temporary, 'tools/ci'), { recursive: true });
+      mkdirSync(join(temporary, 'gradle'));
+      copyFileSync(new URL('./detekt-analysis-health.mjs', import.meta.url), guard);
+      copyFileSync(new URL('../ci/gradle-arguments.mjs', import.meta.url), join(temporary, 'tools/ci/gradle-arguments.mjs'));
+      writeFileSync(join(temporary, 'tools/lint/detekt.yml'), 'config: {}\n');
+      writeFileSync(join(temporary, 'gradle/libs.versions.toml'), 'detekt = "2.0.0-alpha.6"\nkotlin = "2.3.0"\n');
+      for (const source of [
+        'main/kotlin/health/Clean.kt', 'main/kotlin/health/Regex.kt', 'main/kotlin/health/CommaFormatting.kt',
+        'violations/kotlin/health/Unsafe.kt',
+      ]) {
+        writeFileSync(join(temporary, 'tools/lint/analysis-health/src', source), 'package health\n');
+      }
+      writeFileSync(join(temporary, 'tools/ci/read-evidence.mjs'), `
+        import { readFileSync } from 'node:fs';
+        export const readEvidenceBytes = path => readFileSync(path);
+        export const readEvidenceText = path => readFileSync(path, 'utf8');
+      `);
+      writeFileSync(join(temporary, 'tools/ci/run-gradle.mjs'), `
+        import { appendFileSync, mkdirSync, writeFileSync } from 'node:fs';
+        import { join } from 'node:path';
+        const value = flag => process.argv[process.argv.indexOf(flag) + 1];
+        const kind = value('--producer').endsWith('-positive') ? 'positive' : 'negative';
+        appendFileSync('launched.txt', kind + '\\n');
+        const receipt = join(value('--report-root'), 'invocation');
+        mkdirSync(receipt, { recursive: true });
+        writeFileSync(join(receipt, 'summary.json'), JSON.stringify({
+          complete: false, ok: false, commandExitCode: kind === 'positive' ? ${exitCode} : 1,
+          captureExitCode: 0, unexpected: [], errors: ['Interrupted producer'],
+          context: { headSha: 'a'.repeat(40), testedSha: 'b'.repeat(40) },
+        }));
+        writeFileSync(join(receipt, 'raw.log'), 'Interrupted producer\\n');
+        if (kind === 'negative') process.exit(1);
+        process.on('SIGINT', () => process.exit(130));
+        process.on('SIGTERM', () => process.exit(143));
+        // An open inherited stdin keeps the producer waiting and also gives cleanup an EOF exit.
+        process.stdin.on('end', () => process.exit(1));
+        process.stdin.resume();
+        console.log('positive started');
+      `);
+      const driverPath = join(temporary, 'driver.mjs');
+      // IPC invokes the CLI's actual signal listeners on every platform; its child.kill remains real.
+      writeFileSync(driverPath, `
+        import { realpathSync } from 'node:fs';
+        const disconnected = () => process.exit(1);
+        process.on('disconnect', disconnected);
+        process.on('message', signal => process.emit(signal));
+        process.argv = [process.execPath, realpathSync(${JSON.stringify(guard)}), '--report-root', ${JSON.stringify(output)}];
+        await import(${JSON.stringify(pathToFileURL(guard).href)});
+        process.off('disconnect', disconnected);
+        process.disconnect();
+      `);
+      driver = fork(driverPath, [], { cwd: temporary, stdio: ['pipe', 'pipe', 'pipe', 'ipc'] });
+      const cancellation = new AbortController();
+      const timeout = setTimeout(() => cancellation.abort(new Error('CLI did not finish after cancellation')), 10_000);
+      t.after(() => clearTimeout(timeout));
+      let bytes = 0;
+      let signalSent = false;
+      const captured = { stdout: '', stderr: '' };
+      const capture = (stream, chunk) => {
+        bytes += chunk.length;
+        if (bytes > 64 * 1024) cancellation.abort(new Error('CLI output exceeded the test byte limit'));
+        else captured[stream] += chunk.toString('utf8');
+      };
+      driver.stderr.on('data', chunk => capture('stderr', chunk));
+      driver.stdout.on('data', chunk => {
+        capture('stdout', chunk);
+        if (!signalSent && captured.stdout.includes('positive started\n')) {
+          signalSent = true;
+          driver.send(signal, error => { if (error) cancellation.abort(error); });
+        }
+      });
+      const [status, terminatedBy] = await once(driver, 'exit', { signal: cancellation.signal });
+      assert.equal(signalSent, true, captured.stdout + captured.stderr);
+      const receipt = JSON.parse(readFileSync(join(output, 'analysis-health.json'), 'utf8'));
+      assert.deepEqual({
+        signalSent, status, terminatedBy,
+        launched: readFileSync(join(temporary, 'launched.txt'), 'utf8').trim().split('\n'),
+        complete: receipt.complete, ok: receipt.ok,
+      }, {
+        signalSent: true, status: exitCode, terminatedBy: null,
+        launched: ['positive'], complete: false, ok: false,
+      }, captured.stdout + captured.stderr);
+    });
+}
