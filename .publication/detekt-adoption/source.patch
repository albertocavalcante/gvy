+  if (mode === 'actual-wrapper') {
+    for (const file of ['run-gradle.mjs', 'check-gradle-diagnostics.mjs', 'bazel-diagnostics.mjs', 'native-provisioning.mjs',
+      'gradle-memory-options.mjs', 'gradle-memory-probe.mjs', 'gradle-launch.mjs', 'read-evidence.mjs',
+      'windows-private-root.mjs', 'windows-evidence.mjs', 'gradle-diagnostics.json', 'native-provisioning-diagnostics.json']) {
