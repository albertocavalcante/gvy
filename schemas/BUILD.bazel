load("//tools/build_defs:wire.bzl", "wire_proto_library")
load("//tools/build_defs:kotlin.bzl", "kt_test")

# Generate Kotlin code from proto files using Wire
wire_proto_library(
    name = "schemas",
    srcs = glob(["src/main/proto/**/*.proto"]),
    visibility = ["//visibility:public"],
)

kt_test(
    name = "schemas_test",
    srcs = glob(["src/test/kotlin/**/*.kt"], allow_empty = True),
    associates = [":schemas"],
    test_packages = ["com.github.albertocavalcante.schemas"],
)
