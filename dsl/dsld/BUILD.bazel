load("//tools/build_defs:kotlin.bzl", "kt_library", "kt_test")

kt_library(
    name = "dsld",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    visibility = ["//visibility:public"],
    deps = [
        "@maven//:io_arrow_kt_arrow_core_jvm",
        "@maven//:io_github_oshai_kotlin_logging_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm",
    ],
)

# NOTE: Test disabled - GroovyDocParserTest imports from parser/native which creates
# a circular dependency (parser/native depends on groovy-common).
# Need to refactor: move Groovydoc parsing tests to parser/native or extract shared test utils.
kt_test(
    name = "dsld_test",
    srcs = glob(["src/test/kotlin/**/*.kt"], allow_empty = True),
    tags = ["manual"],
    test_packages = ["com.github.albertocavalcante.groovycommon"],
    deps = [
        ":dsld",
        "//parser/native",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_test",
    ],
)
