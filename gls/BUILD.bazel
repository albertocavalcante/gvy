load("@rules_java//java:defs.bzl", "java_binary")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_binary")
load("//tools/build_defs:kotlin.bzl", "kt_library")

# NOTE: groovy-lsp-lib is disabled (tags = ["manual"]) due to:
# - Kotlin 2.2 features (multi-dollar interpolation, nested type aliases)
# - Mordant 3.x API incompatibility
# - Dependencies on disabled modules (viz/ast-model, indexer/scip)
# Enable once source code is updated for Bazel compatibility
kt_library(
    name = "gls-lib",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    resources = glob(["src/main/resources/**/*"]),
    visibility = ["//visibility:public"],
    tags = ["manual"],
    deps = [
        # Internal dependencies
        "//dsl/dsld",
        "//fmt",
        # TODO: build-tool temporarily disabled (requires gradle-tooling-api)
        # "//build-tool",
        "//diagnostics/api",
        "//semantics/core",
        "//semantics/native",
        "//diagnostics/codenarc",
        "//diagnostics/sarif",
        "//dsl/gdsl",
        "//jenkins",
        "//ext/junit",
        "//ext/spock",
        "//ext/testing",
        "//markdown",
        "//parser/core",
        "//parser/native",
        "//indexer/core",
        "//indexer/lsif",
        "//parser/rewrite",
        # "//indexer/scip",  # Disabled: needs protobuf generation for SCIP
        # "//viz/ast-model",  # Disabled: needs Compose Multiplatform

        # LSP4J - Language Server Protocol implementation
        "@maven//:org_eclipse_lsp4j_org_eclipse_lsp4j",
        "@maven//:org_eclipse_lsp4j_org_eclipse_lsp4j_jsonrpc",

        # Groovy - For AST parsing and analysis
        "@maven//:org_apache_groovy_groovy",
        "@maven//:org_apache_groovy_groovy_groovydoc",

        "@maven//:org_gradle_gradle_tooling_api",

        # Kotlin Coroutines
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core",

        # Kotlin Immutable Collections
        "@maven//:org_jetbrains_kotlinx_kotlinx_collections_immutable_jvm",

        # Functional Programming - Arrow-kt
        "@maven//:io_arrow_kt_arrow_core_jvm",

        # Serialization
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json",

        # Logging
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:ch_qos_logback_logback_classic",

        # CLI
        "@maven//:com_github_ajalt_clikt_clikt",
        "@maven//:com_github_ajalt_mordant_mordant",

        # Classpath Scanning
        "@maven//:io_github_classgraph_classgraph",

        # Java Source Parsing
        "@maven//:com_github_javaparser_javaparser_core",
    ],
)

kt_jvm_binary(
    name = "gls",
    main_class = "com.github.albertocavalcante.groovylsp.MainKt",
    visibility = ["//visibility:public"],
    tags = ["manual"],
    runtime_deps = [":gls-lib"],
)

java_binary(
    name = "gls_deploy",
    main_class = "com.github.albertocavalcante.groovylsp.MainKt",
    visibility = ["//visibility:public"],
    tags = ["manual"],
    runtime_deps = [":gls-lib"],
)
