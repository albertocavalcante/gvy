load("//tools/build_defs:kotlin.bzl", "kt_library", "kt_test")

kt_library(
    name = "kernel-core",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    resources = glob(["src/main/resources/**/*"]),
    visibility = ["//visibility:public"],
    deps = [
        "//repl",
        "@maven//:io_github_oshai_kotlin_logging_jvm",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_core_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
        "@maven//:org_zeromq_jeromq",
    ],
)

kt_test(
    name = "kernel-core_test",
    timeout = "short",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    # Grants the tests access to the library's `internal` API (e.g. KernelServer.dispatchFrames).
    associates = [":kernel-core"],
    test_packages = ["com.github.albertocavalcante.gvy.jupyter.core"],
    deps = [
        "//repl",
        "@maven//:io_mockk_mockk_dsl_jvm",
        "@maven//:io_mockk_mockk_jvm",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_jetbrains_kotlin_kotlin_test",
        "@maven//:org_zeromq_jeromq",
    ],
)
