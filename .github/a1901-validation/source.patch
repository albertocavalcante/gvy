+test('bounded tool teardown retains its initiating cause when exit leaves inherited pipes open', { timeout: 10000 }, async t => {
+  for (const scenario of ['stopped', 'timeout', 'stderr', 'output_limit', 'stopped-kill-error']) {
+    const cause = scenario === 'stopped-kill-error' ? 'stopped' : scenario;
+    const killError = scenario === 'stopped-kill-error';
+    const f = fixture(t), started = deferred(), bounded = deferred(), realSpawn = childProcess.spawn;
+    const children = []; let calls = 0, probe;
+    childProcess.spawn = () => {
+      const child = new EventEmitter();
+      child.stdout = new PassThrough(); child.stderr = new PassThrough();
+      child.signals = []; child.unref = () => bounded.resolve();
+      child.kill = signal => {
+        child.signals.push(signal);
+        if (killError) { child.emit('error', new Error('CANARY')); return false; }
+        // The owned child exits, but a descendant still holds its pipe descriptors.
+        child.emit('exit', null, signal); return true;
+      };
+      children.push(child);
+      const call = ++calls;
+      queueMicrotask(() => {
+        if (call < 3) {
+          child.stdout.write(call === 1 ? gc : classes);
+          child.emit('exit', 0, null); child.emit('close', 0, null);
+        } else {
+          if (cause === 'stderr') child.stderr.write('CANARY');
+          if (cause === 'output_limit') child.stdout.write('CANARY'.repeat(6000));
+          started.resolve();
+        }
+      });
+      return child;
+    };
+    syncBuiltinESMExports();
+    try {
+      const io = { ...f.io, sleep: async () => {} }; delete io.runTool;
+      probe = startGradleMemoryProbe({ ...f.options, toolTimeoutMs: 10 }, io);
+      await started.promise;
+      if (cause !== 'stopped') await bounded.promise;
+      const result = await probe.stop();
+      assert.equal(result.complete, false, cause);
+      assert.ok(result.reasonCodes.includes('jstat_termination_timeout'), cause);
+      if (cause !== 'stopped') assert.ok(result.reasonCodes.includes(`jstat_${cause}`), cause);
+      assert.equal(result.tools.cancelled, cause === 'stopped' ? 1 : 0, cause);
+      assert.deepEqual(result.tools.lastFailure, {
+        kind: 'termination_timeout', cause, exitObserved: !killError, closeObserved: false,
+        exitCode: null, exitSignal: killError ? null : 'SIGTERM', termSent: !killError, killSent: false,
+      }, cause);
+      assert.deepEqual(children[2].signals, killError ? ['SIGTERM', 'SIGKILL'] : ['SIGTERM'],
+        'Escalation must stop once the owned child exits');
