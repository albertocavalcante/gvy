load("//tools/build_defs:kotlin.bzl", "kt_library", "kt_test")

kt_library(
    name = "jenkins",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    visibility = ["//visibility:public"],
    deps = [
        "//build-tool",
        "//common",
        "//dsl/gdsl",
        "@maven//:com_vladsch_flexmark_flexmark_html2md_converter",
        "@maven//:io_arrow_kt_arrow_core_jvm",
        "@maven//:io_github_classgraph_classgraph",
        "@maven//:io_github_oshai_kotlin_logging_jvm",
        "@maven//:io_ktor_ktor_client_cio_jvm",
        "@maven//:io_ktor_ktor_client_content_negotiation_jvm",
        "@maven//:io_ktor_ktor_client_core_jvm",
        "@maven//:io_ktor_ktor_http_jvm",
        "@maven//:io_ktor_ktor_io_jvm",
        "@maven//:io_ktor_ktor_serialization_kotlinx_json_jvm",
        "@maven//:org_apache_groovy_groovy",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_core_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
        "@maven//:org_ow2_asm_asm",
    ],
)

kt_test(
    name = "jenkins_test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    associates = [":jenkins"],
    test_packages = ["com.github.albertocavalcante.groovyjenkins"],
    deps = [
        "@maven//:io_ktor_ktor_client_mock_jvm",
        "@maven//:io_mockk_mockk_jvm",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_test",
    ],
)
