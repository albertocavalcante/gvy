pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                script {
                    def targets = ['linux', 'windows']
                    targets.each { target ->
                        echo "Prepared ${target} build"
                    }
                    try {
                        timeout(time: 10, unit: 'MINUTES') {
                            echo 'The script block uses executable Groovy syntax'
                        }
                    } finally {
                        echo 'The script block always reaches cleanup'
                    }
                }
            }
        }
    }
}
