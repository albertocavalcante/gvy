import DefaultSearch from '@astrojs/starlight/components/Search.astro';
---

<DefaultSearch {...Astro.props} />
<script is:inline>
  // Include the visible platform-specific shortcut in the accessible name as well.
  const searchButton = document.querySelector('button[data-open-modal]');
  const shortcut = searchButton?.querySelector('kbd');
  if (searchButton && shortcut) {
    const label = searchButton.querySelector('span[aria-hidden="true"]');
    // Flex gaps separate items visually but do not insert DOM word separators.
    label?.after(document.createTextNode(' '));
    const keyElements = Array.from(shortcut.querySelectorAll('kbd'));
    // The upstream component separates keys visually with CSS but not in the text.
    if (keyElements.length === 2) keyElements[0].after(document.createTextNode(' '));
    const keys = keyElements.map((key) => key.textContent.trim()).join(' ');
    searchButton.setAttribute('aria-label', `${searchButton.getAttribute('aria-label')} ${keys}`);
  }

  // TODO(#2020): Remove when the upstream search handles delayed input focus.
  // See: https://github.com/albertocavalcante/gvy/issues/2020
  const searchDialog = document.querySelector('site-search dialog');
  if (searchDialog) {
    let wasOpen = false;
    let pendingInitialFocus = false;
    const cancelPendingFocus = () => {
      if (searchDialog.open) pendingInitialFocus = false;
    };
    document.addEventListener('keydown', cancelPendingFocus, true);
    document.addEventListener('pointerdown', cancelPendingFocus, true);
    const observer = new MutationObserver(() => {
      if (!searchDialog.open) {
        wasOpen = false;
        pendingInitialFocus = false;
        return;
      }
      if (!wasOpen) {
        wasOpen = true;
        pendingInitialFocus = true;
      }
      const input = searchDialog.querySelector('input');
      if (pendingInitialFocus && input) {
        pendingInitialFocus = false;
        if (document.hasFocus() && document.activeElement !== input) input.focus();
      }
    });
    observer.observe(searchDialog, { attributes: true, attributeFilter: ['open'], childList: true, subtree: true });
  }
</script>
