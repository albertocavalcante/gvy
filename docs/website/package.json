{
  "name": "gvy-docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "bun run scripts/generate.mjs",
    "test": "bun test scripts/*.test.mjs",
    "dev": "bun run generate && astro dev",
    "build": "bun run generate && astro build && bun run scripts/validate.mjs",
    "preview": "astro preview",
    "check": "bun run test && bun run scripts/generate.mjs --check && astro check",
    "validate": "bun run fmt:check && bun run check && astro build && bun run scripts/validate.mjs",
    "fmt:check": "dprint check --config dprint.json"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.5",
    "astro": "7.3.6",
    "cheerio": "^1.2.0",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.33.5",
    "starlight-links-validator": "^0.27.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "dprint": "0.64.3",
    "typescript": "^5.7.3"
  }
}
