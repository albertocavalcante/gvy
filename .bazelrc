# Bazel 9.0.0. See docs/build-observability.md for profiles and artifacts.
# Keep the output base workspace-specific; shared download/action caches are safe.
startup --host_jvm_args=-Xmx2g
startup --max_idle_secs=600

# Remote telemetry and execution are disabled by owner policy. Local evidence works
# without an account or service. Explicit user/command-line overrides remain visible.
common --bes_backend=
build --remote_cache=
build --remote_executor=
build --noremote_upload_local_results

# Reuse downloads and local action results; bound retained action-cache contents.
common --repository_cache=~/.cache/bazel-repo
common --experimental_repository_cache_hardlinks
build --disk_cache=~/.cache/bazel-disk
build --experimental_disk_cache_gc_max_size=5G
build --experimental_disk_cache_gc_max_age=14d
build --experimental_disk_cache_gc_idle_delay=60s

# Shared-machine defaults: scheduling budgets are separate from JVM heap bounds.
build --jobs=2
build --local_resources=cpu=2
build --local_resources=memory=4096
build --worker_max_instances=1
build --worker_max_multiplex_instances=1
build --worker_sandboxing
build --jvmopt=-Xmx768m
build --host_jvmopt=-Xmx1536m

# Compile Java 17 bytecode and run with the hermetic JDK 21 toolchains.
build --java_language_version=17
build --java_runtime_version=remotejdk_21
build --tool_java_language_version=21
build --tool_java_runtime_version=remotejdk_21
build --javacopt=-encoding
build --javacopt=UTF-8
build --javacopt=-Xlint:all
build --javacopt=-Werror

# Existing repository/toolchain contracts.
build --@protobuf//bazel/toolchains:prefer_prebuilt_protoc
build --strategy=KotlinCompile=worker
build --@aspect_rules_ts//ts:supports_workers=false
build --@rules_go//go/config:pure

# Report failures without retrying them into a green invocation.
test --test_output=errors
test --test_keep_going
test --flaky_test_attempts=1

# Local development explicitly permits updating the committed module lockfile.
common:local --lockfile_mode=update

# CI requires the committed dependency graph, while retaining failures and skips.
common:ci --lockfile_mode=error
build:ci --announce_rc
build:ci --color=no
build:ci --curses=no
build:ci --show_timestamps
build:ci --show_progress_rate_limit=30
build:ci --keep_going
test:ci --test_summary=detailed
test:ci --test_verbose_timeout_warnings

# Debugging may retain sandboxes and print full action commands. Use privately.
build:debug --verbose_failures
build:debug --sandbox_debug
build:debug --subcommands=pretty_print
build:debug --announce_rc

# Trace output paths are supplied per invocation; no shared fixed filenames.
build:profile --generate_json_trace_profile=yes

# JSON BEP output path and invocation identity are supplied per invocation.
build:bep --build_event_publish_all_actions
build:bep --build_event_json_file_upload_mode=wait_for_upload_complete

# Optional BES transport policy only. No destination, credential or upload is
# enabled here; remote upload is currently disabled by owner choice.
build:bes --bes_upload_mode=wait_for_upload_complete
build:bes --bes_timeout=60s

# Private overrides load last. Never commit endpoints, headers or credential data.
try-import %workspace%/user.bazelrc
