load("//tools/build_defs:kotlin.bzl", "kt_library", "kt_test")

kt_library(
    name = "codenarc",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    resources = glob(["src/main/resources/**/*"]),
    visibility = ["//visibility:public"],
    deps = [
        "//diagnostics/api",
        "//parser/native",
        "@maven//:io_github_oshai_kotlin_logging_jvm",
        "@maven//:org_apache_groovy_groovy",
        "@maven//:org_codenarc_CodeNarc",
        "@maven//:org_eclipse_lsp4j_org_eclipse_lsp4j",
    ],
    # CodeNarc is imported with its Groovy modules excluded (they are Groovy 3 in some versions);
    # these are the Groovy 4 builds of the modules its POM declares. Without groovy-xml, rule sets
    # fail to load and no diagnostics are published.
    runtime_deps = [
        "@maven//:org_apache_groovy_groovy_ant",
        "@maven//:org_apache_groovy_groovy_groovydoc",
        "@maven//:org_apache_groovy_groovy_json",
        "@maven//:org_apache_groovy_groovy_templates",
        "@maven//:org_apache_groovy_groovy_xml",
    ],
)

kt_test(
    name = "codenarc_test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    associates = [":codenarc"],
    test_packages = ["com.github.albertocavalcante.gvy.diagnostics.codenarc"],
    deps = [
        "//diagnostics/api",
        "@maven//:io_mockk_mockk_dsl_jvm",
        "@maven//:io_mockk_mockk_jvm",
        "@maven//:org_apache_groovy_groovy",
        "@maven//:org_codenarc_CodeNarc",
    ],
)
