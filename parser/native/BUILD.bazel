load("//tools/build_defs:kotlin.bzl", "kt_library", "kt_test")

kt_library(
    name = "native",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    visibility = ["//visibility:public"],
    deps = [
        "//common",
        "//parser/api",
        "@maven//:io_arrow_kt_arrow_core_jvm",
        "@maven//:io_github_oshai_kotlin_logging_jvm",
        "@maven//:org_apache_groovy_groovy",
        "@maven//:org_jetbrains_kotlinx_kotlinx_collections_immutable_jvm",
    ],
)

kt_test(
    name = "native_test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    associates = [":native"],
    resources = glob(["src/test/resources/**/*"]),
    test_packages = ["com.github.albertocavalcante.groovyparser"],
    deps = [
        "//parser/api",
        "@maven//:net_jqwik_jqwik_api",
        "@maven//:org_apache_groovy_groovy",
        "@maven//:org_jetbrains_kotlinx_kotlinx_collections_immutable_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_test_jvm",
    ],
)
