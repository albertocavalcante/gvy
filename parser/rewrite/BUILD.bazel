load("//tools/build_defs:kotlin.bzl", "kt_library", "kt_test")

kt_library(
    name = "rewrite",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    visibility = ["//visibility:public"],
    # rewrite-groovy is imported with Groovy 3 excluded; it needs Groovy 4 at runtime.
    runtime_deps = ["@maven//:org_apache_groovy_groovy"],
    deps = [
        "//parser/api",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:org_openrewrite_rewrite_core",
        "@maven//:org_openrewrite_rewrite_groovy",
        "@maven//:org_openrewrite_rewrite_java",
    ],
)

kt_test(
    name = "rewrite_test",
    timeout = "short",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    associates = [":rewrite"],
    test_packages = ["com.github.albertocavalcante.groovyparser"],
    deps = [
        "//parser/api",
        "@maven//:org_jetbrains_kotlin_kotlin_test",
    ],
)
