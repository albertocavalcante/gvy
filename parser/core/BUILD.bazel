load("//tools/build_defs:kotlin.bzl", "kt_library", "kt_test")

kt_library(
    name = "core",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    visibility = ["//visibility:public"],
    deps = [
        "//parser/api",
        "@maven//:io_github_oshai_kotlin_logging_jvm",
        "@maven//:org_apache_groovy_groovy",
    ],
)

kt_test(
    name = "core_test",
    timeout = "short",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    associates = [":core"],
    # The test-only global transform is registered through META-INF/services under src/test/resources.
    resources = glob(["src/test/resources/**/*"]),
    test_packages = [
        "com.github.albertocavalcante.groovyparser",
        "com.github.albertocavalcante.groovylsp",
    ],
    deps = [
        "//parser/api",
        "@maven//:org_apache_groovy_groovy",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_jetbrains_kotlin_kotlin_test",
    ],
)
