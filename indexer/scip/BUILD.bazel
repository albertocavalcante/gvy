load("//tools/build_defs:kotlin.bzl", "kt_library", "kt_test")

# NOTE: These targets are disabled (tags = ["manual"]) because protobuf code
# generation for SCIP protocol buffers is not yet configured in the Bazel build.
# Once protobuf generation is set up, remove the "manual" tags to re-enable
# these targets in wildcard builds (//...).

kt_library(
    name = "scip",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    visibility = ["//visibility:public"],
    tags = ["manual"],
    deps = [
        "//indexer/core",
        "@maven//:com_squareup_wire_wire_runtime",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
    ],
)

kt_test(
    name = "scip_test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    tags = ["manual"],
    deps = [
        ":scip",
        "@maven//:org_junit_platform_junit_platform_launcher",
    ],
)
