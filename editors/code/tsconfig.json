{
  "compilerOptions": {
    "module": "node20",
    "target": "ES2022",
    "outDir": "out",
    "lib": ["ES2023"],
    "sourceMap": true,
    "rootDir": ".",
    "types": ["node", "mocha"],
    "strict": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "files": [],
  "exclude": ["node_modules", ".vscode-test"],
  "references": [
    {
      "path": "./client"
    }
  ]
}
