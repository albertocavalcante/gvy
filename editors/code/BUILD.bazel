load("@npm//:defs.bzl", "npm_link_all_packages")

# Link all NPM packages from pnpm-lock.yaml
#
# IMPORTANT: This VS Code extension uses a pnpm workspace with a nested client package.
# The workspace is configured in pnpm-workspace.yaml to include the client/ subdirectory.
#
# Setup required:
#   1. The pnpm-workspace.yaml file defines the workspace structure
#   2. After adding/modifying dependencies in either package.json or client/package.json,
#      run `pnpm install` from this directory to regenerate pnpm-lock.yaml
#   3. The lock file will include all dependencies from both the root and client packages
#
# Structure:
#   - editors/code/package.json        (root with devDependencies)
#   - editors/code/client/package.json (client with runtime deps like vscode-languageclient)
#   - editors/code/pnpm-workspace.yaml (workspace configuration)
#   - editors/code/pnpm-lock.yaml      (unified lock file for all packages)
npm_link_all_packages(name = "node_modules")

# Export configuration files for reference by other targets
exports_files([
    "package.json",
    "pnpm-lock.yaml",
    "eslint.config.mjs",
    "tsconfig.json",
    "language-configuration.json",
    "esbuild.js",
])

# ============================================================================
# VSIX Packaging
# ============================================================================
#
# The VS Code extension is packaged as a .vsix file for distribution.
# Full VSIX generation requires the language server JAR, which is currently
# built via Gradle (groovy-lsp module has Bazel compatibility issues).
#
# To build a complete VSIX:
#   1. Build the extension bundle: bazel build //editors/code/client:extension_bundle
#   2. Build the server JAR: ./gradlew :groovy-lsp:shadowJar
#   3. Copy artifacts to the expected locations and run: vsce package
#
# The filegroups below collect the static assets needed for the extension.

# Static assets required for the VSIX
filegroup(
    name = "vsix_static_assets",
    srcs = [
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
        "language-configuration.json",
        "package.json",
    ] + glob([
        "syntaxes/**",
        "resources/**",
    ]),
    visibility = ["//visibility:public"],
)

# Extension bundle from client
# This is the main extension entry point bundled with esbuild
alias(
    name = "extension_bundle",
    actual = "//editors/code/client:extension_bundle",
    visibility = ["//visibility:public"],
)

# AST webview bundle
alias(
    name = "ast_webview_bundle",
    actual = "//editors/code/client:ast_webview_bundle",
    visibility = ["//visibility:public"],
)
