{
  "name": "gvy",
  "displayName": "gvy - Groovy",
  "description": "Groovy language support powered by gls (Groovy Language Server)",
  "version": "0.5.4",
  "publisher": "albertocavalcante",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "groovy",
    "gradle",
    "jenkinsfile",
    "jenkins",
    "pipeline"
  ],
  "activationEvents": [
    "onLanguage:groovy",
    "onLanguage:jenkinsfile",
    "workspaceContains:**/Jenkinsfile",
    "workspaceContains:**/Jenkinsfile.*",
    "workspaceContains:**/*.groovy",
    "onTaskType:groovy-gradle"
  ],
  "main": "./client/out/extension.js",
  "contributes": {
    "taskDefinitions": [
      {
        "type": "groovy-gradle",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "The Gradle task to run, for example build or :app:test."
          },
          "project": {
            "type": "string",
            "description": "Gradle path of the subproject that owns the task, starting with a colon, for example :app. Omit for the root project."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "groovy.restartServer",
        "title": "Groovy: Restart Language Server"
      },
      {
        "command": "groovy.showVersion",
        "title": "Groovy: Show Language Server Version"
      },
      {
        "command": "groovy.checkForUpdates",
        "title": "Groovy: Check for Language Server Updates"
      },
      {
        "command": "groovy.stopServer",
        "title": "Groovy: Stop Language Server"
      },
      {
        "command": "groovy.openLogs",
        "title": "Groovy: Open Server Logs"
      },
      {
        "command": "groovy.showStatusMenu",
        "title": "Groovy: Show Server Status Menu"
      },
      {
        "command": "groovy.reportIssue",
        "title": "Groovy: Report Issue"
      },
      {
        "command": "groovy.toggleDebugLogs",
        "title": "Groovy: Toggle Debug Logging"
      },
      {
        "command": "groovy.setLogLevel",
        "title": "Groovy: Set Log Level"
      },
      {
        "command": "groovy.gradle.build",
        "title": "Gradle: Build"
      },
      {
        "command": "groovy.gradle.test",
        "title": "Gradle: Test"
      },
      {
        "command": "groovy.gradle.clean",
        "title": "Gradle: Clean"
      },
      {
        "command": "groovy.gradle.selectTask",
        "title": "Gradle: Select and Run Task"
      },
      {
        "command": "groovy.gradle.refresh",
        "title": "Gradle: Refresh Project"
      },
      {
        "command": "groovy.test.runAll",
        "title": "Groovy: Run All Tests",
        "icon": "$(testing-run-all-icon)"
      },
      {
        "command": "groovy.test.runCurrentFile",
        "title": "Groovy: Run Tests in Current File",
        "icon": "$(testing-run-icon)"
      },
      {
        "command": "groovy.test.runWithCoverage",
        "title": "Groovy: Run Tests with Coverage",
        "icon": "$(beaker)"
      },
      {
        "command": "groovy.repl.sendFile",
        "title": "Groovy: Send File to REPL"
      },
      {
        "command": "groovy.repl.restart",
        "title": "Groovy: Restart REPL",
        "icon": "$(refresh)"
      },
      {
        "command": "groovy.repl.stop",
        "title": "Groovy: Stop REPL",
        "icon": "$(trash)"
      },
      {
        "command": "groovy.repl.clear",
        "title": "Groovy: Clear REPL",
        "icon": "$(clear-all)"
      },
      {
        "command": "groovy.test.generate",
        "title": "Groovy: Generate Spock Specification",
        "category": "Test"
      },
      {
        "command": "groovy.repl.show",
        "title": "Groovy: Show REPL",
        "icon": "$(terminal)"
      },
      {
        "command": "groovy.ast.show",
        "title": "Groovy: Show AST Explorer",
        "icon": "$(symbol-structure)",
        "category": "View"
      },
      {
        "command": "groovy.configureJava",
        "title": "Groovy: Configure Java Runtime",
        "icon": "$(coffee)"
      },
      {
        "command": "groovy.addFoojayResolver",
        "title": "Groovy: Add Foojay Resolver Plugin",
        "icon": "$(add)"
      },
      {
        "command": "groovy.dependencies.refresh",
        "title": "Groovy: Refresh Dependencies",
        "icon": "$(refresh)"
      },
      {
        "command": "groovy.dependencies.copyCoordinate",
        "title": "Copy Dependency Coordinate"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "groovyDependencies",
          "name": "Groovy Dependencies",
          "icon": "$(package)",
          "contextualTitle": "Dependencies",
          "when": "groovy.hasProject"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "groovy.repl.sendFile",
          "when": "false"
        },
        {
          "command": "groovy.repl.restart",
          "when": "false"
        },
        {
          "command": "groovy.repl.stop",
          "when": "false"
        },
        {
          "command": "groovy.repl.clear",
          "when": "false"
        },
        {
          "command": "groovy.repl.show",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "groovy.dependencies.refresh",
          "when": "view == groovyDependencies",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "groovy.dependencies.copyCoordinate",
          "when": "view == groovyDependencies && viewItem == dependency"
        }
      ]
    },
    "keybindings": [
      {
        "command": "groovy.ast.show",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorLangId == groovy"
      }
    ],
    "languages": [
      {
        "id": "groovy",
        "aliases": [
          "Groovy",
          "groovy"
        ],
        "extensions": [
          ".groovy",
          ".gvy",
          ".gy",
          ".gsh",
          ".gradle"
        ],
        "firstLine": "^#!.*\\b(groovy|gradle)\\b",
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jenkinsfile",
        "aliases": [
          "Jenkinsfile",
          "Jenkins Pipeline"
        ],
        "filenames": [
          "Jenkinsfile"
        ],
        "filenamePatterns": [
          "Jenkinsfile.*",
          "Jenkinsfile-*",
          "Jenkinsfile_*",
          "*.jenkinsfile",
          "*.Jenkinsfile"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "groovy",
        "scopeName": "source.groovy",
        "path": "./syntaxes/groovy.tmLanguage.json"
      },
      {
        "language": "jenkinsfile",
        "scopeName": "source.groovy",
        "path": "./syntaxes/groovy.tmLanguage.json"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "unnecessary",
        "description": "Unused/unnecessary code (for dimming unused imports)"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "groovy",
        "scopes": {
          "namespace": [
            "entity.name.namespace"
          ],
          "type": [
            "entity.name.type"
          ],
          "class": [
            "entity.name.type.class",
            "support.class"
          ],
          "enum": [
            "entity.name.type.enum"
          ],
          "interface": [
            "entity.name.type.interface"
          ],
          "struct": [
            "entity.name.type.struct"
          ],
          "typeParameter": [
            "entity.name.type.parameter"
          ],
          "parameter": [
            "variable.parameter"
          ],
          "variable": [
            "variable.other"
          ],
          "property": [
            "variable.other.property"
          ],
          "enumMember": [
            "variable.other.enummember"
          ],
          "function": [
            "entity.name.function"
          ],
          "method": [
            "entity.name.function.member"
          ],
          "macro": [
            "entity.name.tag.pipeline.jenkins"
          ],
          "keyword": [
            "keyword"
          ],
          "modifier": [
            "storage.modifier"
          ],
          "comment": [
            "comment"
          ],
          "string": [
            "string"
          ],
          "number": [
            "constant.numeric"
          ],
          "regexp": [
            "string.regexp"
          ],
          "operator": [
            "keyword.operator"
          ],
          "decorator": [
            "entity.name.function.decorator"
          ],
          "class.declaration": [
            "entity.name.type.class.declaration",
            "support.class",
            "entity.name.type"
          ],
          "*.declaration": [
            "entity.name.function.definition"
          ],
          "*.definition": [
            "entity.name.function.definition"
          ],
          "*.readonly": [
            "variable.other.constant"
          ],
          "*.static": [
            "entity.name.function.static"
          ],
          "*.deprecated": [
            "invalid.deprecated"
          ],
          "*.unnecessary": [
            "meta.unnecessary"
          ]
        }
      },
      {
        "language": "jenkinsfile",
        "scopes": {
          "namespace": [
            "entity.name.namespace"
          ],
          "type": [
            "entity.name.type"
          ],
          "class": [
            "entity.name.type.class",
            "support.class"
          ],
          "enum": [
            "entity.name.type.enum"
          ],
          "interface": [
            "entity.name.type.interface"
          ],
          "struct": [
            "entity.name.type.struct"
          ],
          "typeParameter": [
            "entity.name.type.parameter"
          ],
          "parameter": [
            "variable.parameter"
          ],
          "variable": [
            "variable.other"
          ],
          "property": [
            "variable.other.property"
          ],
          "enumMember": [
            "variable.other.enummember"
          ],
          "function": [
            "entity.name.function"
          ],
          "method": [
            "entity.name.function.member"
          ],
          "macro": [
            "entity.name.tag.pipeline.jenkins"
          ],
          "keyword": [
            "keyword"
          ],
          "modifier": [
            "storage.modifier"
          ],
          "comment": [
            "comment"
          ],
          "string": [
            "string"
          ],
          "number": [
            "constant.numeric"
          ],
          "regexp": [
            "string.regexp"
          ],
          "operator": [
            "keyword.operator"
          ],
          "decorator": [
            "entity.name.function.decorator"
          ],
          "class.declaration": [
            "entity.name.type.class.declaration",
            "support.class",
            "entity.name.type"
          ],
          "*.declaration": [
            "entity.name.function.definition"
          ],
          "*.definition": [
            "entity.name.function.definition"
          ],
          "*.readonly": [
            "variable.other.constant"
          ],
          "*.static": [
            "entity.name.function.static"
          ],
          "*.deprecated": [
            "invalid.deprecated"
          ],
          "*.unnecessary": [
            "meta.unnecessary"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[jenkinsfile]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[groovy]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "Groovy Language Server",
      "properties": {
        "groovy.languageServer.javaHome": {
          "scope": "machine",
          "type": "string",
          "description": "Path to Java home for running the Groovy Language Server (requires Java 17+). If not set, auto-detected."
        },
        "groovy.java.home": {
          "scope": "machine",
          "type": "string",
          "deprecationMessage": "Use 'groovy.languageServer.javaHome' instead. This setting will be removed in a future version.",
          "description": "DEPRECATED: Use groovy.languageServer.javaHome"
        },
        "groovy.project.javaHome": {
          "type": "string",
          "scope": "machine",
          "description": "Path to Java home for project build/test execution (Maven, Gradle). If not set, uses system JAVA_HOME."
        },
        "groovy.jdk.suppressMismatchWarning": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Suppress warnings when LSP JDK version is newer than project target. Set this if you intentionally use a newer JDK and accept potential 'Unsupported class file major version' errors."
        },
        "groovy.configuration.runtimes": {
          "type": "array",
          "scope": "machine",
          "description": "Map Java versions to local JDK installations. Used to select the appropriate JDK for projects with specific version requirements.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "path"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Identifier for this JDK (e.g., 'JDK-8', 'JDK-17')",
                "enum": [
                  "JDK-8",
                  "JDK-11",
                  "JDK-17",
                  "JDK-21",
                  "JDK-22",
                  "JDK-23",
                  "JDK-24",
                  "JDK-25"
                ]
              },
              "path": {
                "type": "string",
                "description": "Absolute path to the JDK installation directory"
              },
              "default": {
                "type": "boolean",
                "description": "Reserved for future use. Currently not interpreted by the extension."
              }
            }
          },
          "default": []
        },
        "groovy.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "markdownDescription": "Verbosity of the language server protocol trace. Tracing is recorded only while the **Groovy Language Server Trace** output channel's log level is set to Trace (Output view > gear icon > Set Log Level)."
        },
        "groovy.statusBar.show": {
          "type": "string",
          "enum": [
            "always",
            "onGroovyFile",
            "never"
          ],
          "default": "onGroovyFile",
          "enumDescriptions": [
            "Always show the status bar item",
            "Only show when editing Groovy files",
            "Never show the status bar item"
          ],
          "description": "When to show the Groovy server status bar item"
        },
        "groovy.statusBar.clickAction": {
          "type": "string",
          "enum": [
            "menu",
            "logs",
            "restart"
          ],
          "default": "menu",
          "enumDescriptions": [
            "Open the server action menu",
            "Open the server output logs",
            "Restart the language server"
          ],
          "description": "Action to perform when clicking the status bar item"
        },
        "groovy.server.maxNumberOfProblems": {
          "scope": "resource",
          "type": "number",
          "default": 100,
          "description": "Controls the maximum number of problems produced by the server."
        },
        "groovy.server.startTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "maximum": 2147483,
          "description": "Seconds to wait for the language server to start before giving up and stopping it, so Stop and Restart stay usable. Set to 0 to wait indefinitely."
        },
        "groovy.server.path": {
          "scope": "machine",
          "type": "string",
          "description": "Absolute path to a custom Groovy Language Server JAR. If not set, the embedded server is used."
        },
        "groovy.languageServer.engine": {
          "type": "string",
          "enum": [
            "core",
            "native"
          ],
          "default": "core",
          "description": "Select the parser engine to use (Core: GroovyParser, Native: Groovy 3)."
        },
        "groovy.server.vmargs": {
          "scope": "machine",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-XX:+ExitOnOutOfMemoryError"
          ],
          "description": "JVM options passed to the language server before -jar, for example [\"-Xmx2g\"]. The default makes the server exit on OutOfMemoryError so it is restarted automatically. Setting this replaces the default list. Non-string entries are ignored. Requires a server restart."
        },
        "groovy.server.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "description": "Logging level for the language server."
        },
        "groovy.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable code formatting for Groovy files"
        },
        "groovy.compilation.mode": {
          "type": "string",
          "enum": [
            "workspace",
            "single-file"
          ],
          "default": "workspace",
          "enumDescriptions": [
            "Compile all files together for full project context (slower, more accurate)",
            "Compile each file independently for faster feedback (may miss cross-file errors)"
          ],
          "description": "Compilation mode for Groovy files"
        },
        "groovy.compilation.incrementalThreshold": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Number of files changed to trigger full workspace recompilation"
        },
        "groovy.compilation.maxWorkspaceFiles": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "description": "Maximum number of files to compile in workspace mode. Larger projects automatically use single-file mode."
        },
        "groovy.compilation.cacheMaxEntries": {
          "type": "integer",
          "default": 300,
          "minimum": 1,
          "description": "Maximum number of compiled files kept in memory. Open documents are always kept; the least recently used closed files beyond this are evicted and recompiled on next use."
        },
        "groovy.repl.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the Groovy REPL integration. The REPL is not yet supported by the language server."
        },
        "groovy.repl.maxSessions": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Maximum number of concurrent REPL sessions. The REPL is not yet supported by the language server."
        },
        "groovy.repl.sessionTimeoutMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "description": "Idle timeout for REPL sessions (minutes). The REPL is not yet supported by the language server."
        },
        "groovy.codenarc.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable CodeNarc static analysis for Groovy files"
        },
        "groovy.codenarc.propertiesFile": {
          "type": "string",
          "scope": "machine",
          "description": "Path to a custom CodeNarc .properties file. If not set, auto-detection is used. Rulesets (.groovy) from the workspace are never evaluated."
        },
        "groovy.codenarc.autoDetect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect project type (Jenkins, Gradle, Spock) and apply appropriate CodeNarc ruleset"
        },
        "groovy.jenkins.filePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Jenkinsfile",
            "Jenkinsfile.*",
            "Jenkinsfile-*",
            "Jenkinsfile_*",
            "*.jenkinsfile",
            "*.Jenkinsfile",
            "vars/*.groovy"
          ],
          "description": "File patterns to recognize as Jenkins Pipeline files"
        },
        "groovy.jenkins.sharedLibraries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Library name (e.g., 'my-pipeline-lib')"
              },
              "jar": {
                "type": "string",
                "description": "Absolute path to library JAR file"
              },
              "sourcesJar": {
                "type": "string",
                "description": "Absolute path to library sources JAR (optional, for navigation)"
              }
            },
            "required": [
              "name",
              "jar"
            ]
          },
          "default": [],
          "markdownDescription": "Jenkins shared libraries configuration. Each library provides custom pipeline steps and DSL extensions.\n\nExample:\n```json\n[\n  {\n    \"name\": \"my-pipeline-lib\",\n    \"jar\": \"/path/to/my-pipeline-lib.jar\",\n    \"sourcesJar\": \"/path/to/my-pipeline-lib-sources.jar\"\n  }\n]\n```"
        },
        "groovy.jenkins.gdslPaths": {
          "scope": "machine",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Paths to IntelliJ GDSL files for DSL enhancements. GDSL files provide dynamic method and property contributions for pipeline DSLs. Can only be set in user (or remote machine) settings, because the scripts run in the server.\n\nExample: `[\"/path/to/jenkins.gdsl\"]`"
        },
        "groovy.jenkins.gdslExecution.enabled": {
          "scope": "machine",
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable execution of GDSL scripts. Disabled by default for security because GDSL runs arbitrary Groovy code. Can only be set in user (or remote machine) settings, never by a workspace."
        },
        "groovy.jenkins.pluginsTxtPath": {
          "type": "string",
          "description": "Explicit path to Jenkins plugins.txt (overrides auto-discovery)"
        },
        "groovy.jenkins.plugins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional Jenkins plugins to include (plugin IDs, e.g. 'workflow-basic-steps')"
        },
        "groovy.jenkins.includeDefaultPlugins": {
          "type": "boolean",
          "default": true,
          "description": "Include Groovy LSP built-in default Jenkins plugins (recommended)"
        },
        "groovy.update.checkOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Check for Language Server updates when the extension is activated"
        },
        "groovy.update.checkIntervalHours": {
          "type": "number",
          "default": 24,
          "minimum": 1,
          "description": "Hours between automatic update checks (minimum: 1)"
        },
        "groovy.update.notifications": {
          "type": "string",
          "enum": [
            "off",
            "onlyWhenOutdated",
            "always"
          ],
          "default": "onlyWhenOutdated",
          "enumDescriptions": [
            "Disable update notifications",
            "Show notification only when a new version is available",
            "Always show notification after checking for updates"
          ],
          "description": "When to show update notifications"
        },
        "groovy.ai.tools.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "description": "Master switch to enable AI tools (e.g., symbol search, definition lookup) for LLMs."
        },
        "groovy.ai.tools.allowed": {
          "type": "array",
          "scope": "machine",
          "items": {
            "type": "string"
          },
          "default": [
            "all"
          ],
          "description": "List of allowed tools. Use ['all'] to enable all tools, or specify individual tool names (e.g., ['groovy_find_symbol'])."
        },
        "groovy.gradle.buildStrategy": {
          "type": "string",
          "enum": [
            "auto",
            "gradle",
            "maven"
          ],
          "default": "auto",
          "description": "Build tool strategy for dependency resolution."
        },
        "groovy.gradle.targetClasspaths.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "Compile each Gradle source set's files against that source set's own compile classpath (for example, test-only dependencies stay out of `main`). Runs one more Gradle Tooling API operation per dependency resolution, so the classpath appears later. Can only be set in user (or remote machine) settings, because it runs the build's configuration."
        },
        "groovy.codelens.test.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable CodeLens for test Run/Debug buttons"
        },
        "groovy.codelens.test.source": {
          "type": "string",
          "enum": [
            "lsp",
            "extension",
            "both"
          ],
          "default": "lsp",
          "enumDescriptions": [
            "Use Language Server CodeLens (AST-based, more accurate)",
            "Use traditional Extension CodeLens (fallback mode)",
            "Show CodeLens from both sources"
          ],
          "description": "Source for test Run/Debug/Coverage CodeLens"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "groovy_find_symbol",
        "tags": [
          "workspace",
