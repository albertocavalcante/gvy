  "scripts": {
    "vscode:prepublish": "pnpm run prepare-server && node tools/validate-server.js && pnpm run package-build",
    "prepare-server": "node tools/prepare-server.js",
    "prepare-server:local": "PREFER_LOCAL=true node tools/prepare-server.js",
    "prepare-server:download": "FORCE_DOWNLOAD=true node tools/prepare-server.js",
    "prepare-server:build": "BUILD_LOCAL=true node tools/prepare-server.js",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "package-build": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "watch": "pnpm run \"/^watch:/\"",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project client/tsconfig.json",
    "check-types": "tsc --noEmit --project client/tsconfig.json && pnpm run check-tools",
    "lint": "eslint \"client/src/**/*.ts\" \"client/test/**/*.ts\"",
    "format": "prettier --write \"**/*.{ts,js,json,css,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,css,md,yaml,yml}\"",
    "package": "vsce package --no-dependencies",
    "install-extension": "node tools/install-extension.js",
    "clean": "rm -rf client/out/ client/tsconfig.tsbuildinfo server/*.jar server/.gls-version",
    "postinstall": "pnpm run prepare-server",
    "test": "mocha",
    "test:watch": "mocha --watch",
    "compile:tests": "tsc -b --force client/tsconfig.json",
    "test:integration": "pnpm run compile:tests && vscode-test",
    "test:all": "pnpm run test && pnpm run test:integration",
    "check-tools": "tsc --project tools/tsconfig.json && eslint --config tools/eslint.config.mjs tools"
  },
