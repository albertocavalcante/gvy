{
  "compilerOptions": {
    "module": "node20",
    "target": "ES2022",
    "outDir": "out",
    "lib": ["ES2023", "DOM"],
    "sourceMap": true,
    "rootDir": "src",
    "types": ["node", "mocha"],
    "strict": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "composite": true,
    "declaration": true
  },
  "include": ["src", "src/test"],
  "exclude": ["node_modules", ".vscode-test"]
}
