<idea-plugin>
    <id>org.gvy.jetbrains</id>
    <name>GVY</name>
    <vendor>gvy contributors</vendor>
    <description>Opt-in local GVY language client for Groovy projects.</description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>
    <applicationListeners>
        <listener class="org.gvy.jetbrains.GvyTrustedProjectListener"
                  topic="com.intellij.ide.trustedProjects.TrustedProjectsListener"/>
    </applicationListeners>
    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.serverSupportProvider implementation="org.gvy.jetbrains.GvyServerSupportProvider"/>
        <projectConfigurable id="org.gvy.jetbrains.settings" parentId="language" displayName="GVY"
                             instance="org.gvy.jetbrains.GvyConfigurable"/>
    </extensions>
</idea-plugin>
