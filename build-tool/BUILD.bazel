load("//tools/build_defs:kotlin.bzl", "kt_library", "kt_test")

kt_library(
    name = "build-tool",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    resources = glob(["src/main/resources/**/*"]),
    visibility = ["//visibility:public"],
    deps = [
        "@maven//:ch_epfl_scala_bsp4j",
        "@maven//:io_github_oshai_kotlin_logging_jvm",
        "@maven//:org_apache_maven_maven_model",
        "@maven//:org_apache_maven_maven_model_builder",
        "@maven//:org_apache_maven_maven_resolver_provider",
        "@maven//:org_apache_maven_resolver_maven_resolver_api",
        "@maven//:org_apache_maven_resolver_maven_resolver_spi",
        "@maven//:org_apache_maven_resolver_maven_resolver_supplier",
        "@maven//:org_apache_maven_resolver_maven_resolver_transport_http",
        "@maven//:org_codehaus_plexus_plexus_utils",
        "@maven//:org_eclipse_lsp4j_org_eclipse_lsp4j_jsonrpc",
        "@maven//:org_gradle_gradle_tooling_api",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_core_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
    ],
)

kt_test(
    name = "build-tool_test",
    # TODO(#1607): Retain a portable moderate timeout until cross-platform headroom is proven.
    srcs = glob(
        ["src/test/kotlin/**/*.kt"],
        allow_empty = True,
    ),
    associates = [":build-tool"],
    # Data: directories and their contents that need filesystem access
    data = glob([
        "src/test/resources/test-*-project/**/*",
        "src/test/resources/non-*-project/**/*",
    ]),
    # Resources: files loaded via classloader (txt, xml files)
    resources = glob([
        "src/test/resources/network-policy/*.json",
        "src/test/resources/**/*.txt",
        "src/test/resources/**/*.xml",
    ]),
    test_packages = ["com.github.albertocavalcante.gvy.build"],
    deps = [
        "@maven//:ch_epfl_scala_bsp4j",
        "@maven//:io_mockk_mockk_dsl_jvm",
        "@maven//:io_mockk_mockk_jvm",
        "@maven//:org_apache_groovy_groovy",
        "@maven//:org_apache_groovy_groovy_ant",
        "@maven//:org_apache_groovy_groovy_xml",
        "@maven//:org_apache_maven_maven_model",
        "@maven//:org_apache_maven_resolver_maven_resolver_api",
        "@maven//:org_apache_maven_resolver_maven_resolver_spi",
        "@maven//:org_gradle_gradle_tooling_api",
        "@maven//:org_jetbrains_kotlin_kotlin_test",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_test_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_core_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
    ],
)
