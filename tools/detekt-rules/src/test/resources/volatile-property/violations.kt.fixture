// Every line ending in the FLAG marker must be reported, and nothing else.
package fixtures

import kotlin.concurrent.Volatile as CommonVolatile
import kotlin.jvm.Volatile as JvmVolatile
import kotlin.jvm.Volatile as `EscapedAlias`

class Fields {
    @Volatile var plain = false // FLAG

    @Volatile // FLAG
    private var onItsOwnLine: String? = null

    @Volatile private var withModifier = 0L // FLAG
    @Volatile() var withParentheses = false // FLAG
    @field:Volatile var withUseSiteTarget = false // FLAG
    @[Volatile] var inAnnotationList = false // FLAG
    @kotlin.jvm.Volatile var qualifiedJvm = false // FLAG
    @kotlin.concurrent.Volatile var qualifiedCommon = false // FLAG
    @JvmVolatile var aliasedJvm = false // FLAG
    @CommonVolatile var aliasedCommon = false // FLAG
    @Transient @Volatile var afterAnotherAnnotation = false // FLAG
}

class Holder(@Volatile var constructorProperty: Int) // FLAG

object Singleton {
    @Volatile private var instance: Any? = null // FLAG
}

class WithCompanion {
    companion object {
        @Volatile var shared = 0 // FLAG
    }
}

fun anonymousObject(): Any = object {
    @Volatile var inside = 0 // FLAG
}

// Names are read by PSI segment, so backticks, comments and line breaks inside a name do not hide it.
class Spellings {
    @`Volatile` var escaped = false // FLAG
    @kotlin.jvm.`Volatile` var escapedQualified = false // FLAG
    @`kotlin`.`jvm`.Volatile var escapedPackage = false // FLAG
    @field:`Volatile` var escapedWithUseSiteTarget = false // FLAG
    @kotlin.jvm./* between */Volatile var commented = false // FLAG
    @kotlin.jvm // FLAG
        .Volatile
    var splitAcrossLines = false
    @EscapedAlias var viaEscapedAlias = false // FLAG
    @`EscapedAlias` var viaEscapedAliasEscaped = false // FLAG
}

// A typealias of Kotlin's annotation is reported where it is declared. Its uses look like any other annotation.
typealias JvmVolatileAlias = kotlin.jvm.Volatile // FLAG
typealias CommonVolatileAlias = kotlin.concurrent.Volatile // FLAG
typealias PlainVolatileAlias = Volatile // FLAG
typealias AliasOfImportAlias = JvmVolatile // FLAG
typealias EscapedVolatileAlias = kotlin.jvm.`Volatile` // FLAG

class WithAliasedField {
    @JvmVolatileAlias var reportedAtTheTypealias = false
}
