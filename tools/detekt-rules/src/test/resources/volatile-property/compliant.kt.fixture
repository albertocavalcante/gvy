// Nothing here may be reported. The file imports no other Volatile, so each spelling below names Kotlin's annotation.
package fixtures

/**
 * Mentions of @Volatile, @kotlin.jvm.Volatile and @kotlin.concurrent.Volatile in KDoc are not annotations, nor are
 * the links [Volatile] and [kotlin.jvm.Volatile].
 *
 * @Volatile at the start of a KDoc line is a tag, not an annotation.
 */
class Mentions {
    // @Volatile in a line comment
    // @kotlin.jvm.Volatile in a line comment

    /* @kotlin.concurrent.Volatile in a block comment */
    val text = "@Volatile var flag = false"
    val qualifiedText = "@kotlin.jvm.Volatile var flag = false"
    val rawText = """@kotlin.concurrent.Volatile var flag = false"""
    val volatile = "a property named volatile"

    /** The KDoc of a property that mentions @kotlin.jvm.Volatile. */
    var documented = false
}

class OtherAnnotations {
    @Transient var transientField = false
    @JvmField var jvmField = 0
    @Synchronized fun synchronizedFunction() = Unit
    @kotlin.jvm.JvmField var qualifiedOther = 0
    @com.example.annotations.Volatile var otherPackage = false
    @VolatileLike var similarName = false
}

class Suppressed {
    @Suppress("VolatileProperty") // A documented exception: a field updater needs a real volatile field.
    @Volatile
    var updatedThroughFieldUpdater = 0
}

// A typealias of anything else is not reported, nor is the annotation class used as a type or a class literal.
typealias Marker = com.example.annotations.Volatile
typealias Flags = List<Boolean>
typealias Annotations = List<kotlin.jvm.Volatile>

class TypeUses {
    val marker: Volatile? = null
    val type = kotlin.jvm.Volatile::class
}

@Suppress("VolatileProperty") // A suppression with a reason also covers a typealias.
typealias SuppressedAlias = kotlin.jvm.Volatile
