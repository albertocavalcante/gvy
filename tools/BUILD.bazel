"""Build definitions and toolchains for the Groovy Language Server project."""

load("@rules_java//java:defs.bzl", "java_binary")
load("@rules_kotlin//kotlin:core.bzl", "define_kt_toolchain")

# Kotlin toolchain with performance optimizations
# Using Kotlin 2.3.0 compiler from locally-built rules_kotlin (master branch)
define_kt_toolchain(
    name = "kotlin_toolchain",
    api_version = "2.3",  # Kotlin 2.3 features (nested type aliases, etc.)
    experimental_multiplex_workers = True,  # Better worker utilization
    experimental_report_unused_deps = "warn",

    # Strictness (start with warn, upgrade to error later)
    experimental_strict_kotlin_deps = "warn",

    # Performance optimizations
    experimental_use_abi_jars = True,  # 20-40% faster incremental builds
    jvm_target = "21",
    language_version = "2.3",
)

# ==============================================================================
# Wire Compiler for Proto Code Generation
# ==============================================================================
#
# NOTE: Tagged "manual" to exclude from wildcard builds.
#
# KNOWN ISSUE: GMM (--enable-modules) causes rules_jvm_external to resolve
# wire-compiler's jar attribute to the sources jar instead of the main jar,
# resulting in ClassNotFoundException for com.squareup.wire.WireCompiler.
#
# wire-compiler is a JVM-only CLI tool (not KMP like wire-runtime).
#
# Tracking: https://github.com/albertocavalcante/gvy/issues/1029
# Related: https://github.com/bazel-contrib/rules_jvm_external/issues/608
# ==============================================================================
java_binary(
    name = "wire_compiler",
    main_class = "com.squareup.wire.WireCompiler",
    runtime_deps = ["@maven//:com_squareup_wire_wire_compiler"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
