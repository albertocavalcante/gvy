load("//tools/build_defs:kotlin.bzl", "kt_library", "kt_test")

kt_library(
    name = "openrewrite",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    visibility = ["//visibility:public"],
    deps = [
        "//semantics/core",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:org_openrewrite_rewrite_java",
    ],
)

kt_test(
    name = "openrewrite_test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    associates = [":openrewrite"],
    test_packages = ["com.github.albertocavalcante.gvy"],
    deps = [
        "//semantics/core",
        "@maven//:org_apache_groovy_groovy",  # Explicit Groovy 4.x (rewrite-groovy's Groovy 3.x is excluded)
        "@maven//:org_openrewrite_rewrite_core",
        "@maven//:org_openrewrite_rewrite_groovy",
        "@maven//:org_openrewrite_rewrite_java",
    ],
)
