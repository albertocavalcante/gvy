load("//tools/build_defs:kotlin.bzl", "kt_library", "kt_test")

kt_library(
    name = "fmt",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    visibility = ["//visibility:public"],
    deps = [
        "//common",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:org_openrewrite_rewrite_core",
        "@maven//:org_openrewrite_rewrite_groovy",
        "@maven//:org_openrewrite_rewrite_java",
        # TokenStreamGuard compiles against the Groovy lexer. rewrite-groovy is imported with
        # Groovy 3 excluded, so this Groovy 4 dependency also serves it at runtime.
        "@maven//:org_apache_groovy_groovy",
        "@maven//:org_slf4j_slf4j_api",
    ],
)

kt_test(
    name = "groovy-formatter_test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    associates = [":fmt"],
    test_packages = ["com.github.albertocavalcante.gvy.fmt"],
    deps = [
        "@maven//:ch_qos_logback_logback_classic",
        "@maven//:ch_qos_logback_logback_core",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
        "@maven//:org_slf4j_slf4j_api",
    ],
)
